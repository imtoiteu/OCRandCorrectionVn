<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.4 – Minh họa kết quả OCR trên một số nhóm tài liệu  (khung trình bày)" id="fig_4_4_result_examples_template"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.4 – Minh họa kết quả OCR trên một số nhóm tài liệu  (khung trình bày)" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="COMPOSITION TEMPLATE — no OCR output is reproduced here. The boxes name the sample files that exist in the repository and where each capture must be inserted." style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="warn" value="This figure cannot be generated from source code: it shows recognition output on real documents. The template below lists the sample material that already exists in the repository so the captures can be produced consistently. Do not reuse the stored reference outputs as if they were results of this system without re-running them." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1320" height="58" as="geometry"/></mxCell><mxCell id="c1_h" value="a)  Clear printed text" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c1_s" value="Source in the repository&lt;br&gt;glm-ocr-server/examples/source/page.png&lt;br&gt;&lt;br&gt;Existing GLM-OCR reference output&lt;br&gt;examples/result/page/page.json · page.md&lt;br&gt;layout_vis/layout_page0.jpg" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c1_l" value="INSERT CAPTURE&lt;br&gt;&lt;br&gt;left: the original document&lt;br&gt;right: the OCR result produced by&lt;br&gt;this system&lt;br&gt;&lt;br&gt;mark two or three correct and&lt;br&gt;incorrect positions on the image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c1_c" value="Caption to write&lt;br&gt;• engine used (selected_engine)&lt;br&gt;• page processing time (processing_time_ms)&lt;br&gt;• region count / mean confidence&lt;br&gt;• the specific error type observed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="c2_h" value="b)  Table / structured layout" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c2_s" value="Source in the repository&lt;br&gt;glm-ocr-server/examples/source/table.png&lt;br&gt;&lt;br&gt;Existing GLM-OCR reference output&lt;br&gt;examples/result/table/table.json · table.md&lt;br&gt;plus ui/_runs/0359de69/ (recorded run)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="380" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c2_l" value="INSERT CAPTURE&lt;br&gt;&lt;br&gt;left: the original document&lt;br&gt;right: the OCR result produced by&lt;br&gt;this system&lt;br&gt;&lt;br&gt;mark two or three correct and&lt;br&gt;incorrect positions on the image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="380" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c2_c" value="Caption to write&lt;br&gt;• engine used (selected_engine)&lt;br&gt;• page processing time (processing_time_ms)&lt;br&gt;• region count / mean confidence&lt;br&gt;• the specific error type observed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="380" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="c3_h" value="c)  Handwriting  (difficult case)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c3_s" value="Source in the repository&lt;br&gt;glm-ocr-server/examples/source/handwritten.png&lt;br&gt;&lt;br&gt;Existing GLM-OCR reference output&lt;br&gt;examples/result/handwritten/handwritten.json · .md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="720" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c3_l" value="INSERT CAPTURE&lt;br&gt;&lt;br&gt;left: the original document&lt;br&gt;right: the OCR result produced by&lt;br&gt;this system&lt;br&gt;&lt;br&gt;mark two or three correct and&lt;br&gt;incorrect positions on the image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="720" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c3_c" value="Caption to write&lt;br&gt;• engine used (selected_engine)&lt;br&gt;• page processing time (processing_time_ms)&lt;br&gt;• region count / mean confidence&lt;br&gt;• the specific error type observed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="720" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="c4_h" value="d)  Low-quality photograph  —  MISSING" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c4_s" value="No low-quality photograph exists in the repository.&lt;br&gt;A real photograph taken by the author must be added&lt;br&gt;and uploaded through the application.&lt;br&gt;&lt;br&gt;The report requires at least one difficult case, so this&lt;br&gt;sample cannot be skipped." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4_l" value="INSERT CAPTURE&lt;br&gt;&lt;br&gt;left: the original document&lt;br&gt;right: the OCR result produced by&lt;br&gt;this system&lt;br&gt;&lt;br&gt;mark two or three correct and&lt;br&gt;incorrect positions on the image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c4_c" value="Caption to write&lt;br&gt;• engine used (selected_engine)&lt;br&gt;• page processing time (processing_time_ms)&lt;br&gt;• region count / mean confidence&lt;br&gt;• the specific error type observed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="n1" value="How to obtain each capture reproducibly: upload the sample through POST /api/upload, run OCR with a named engine, then use the OCR workspace to place the page canvas (with the recognition boxes shown) next to the Markdown or Raw tab. The values needed for the caption are visible in the statistics strip and are also recorded in activity_logs, so the figure and the text can be kept consistent." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1320" height="84" as="geometry"/></mxCell><mxCell id="n2" value="Honesty requirement stated in the report: at least one difficult case must be included, and the examples must not be selected only from successful runs. The repository provides three usable samples; the low-quality photograph has to be supplied by the author." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>