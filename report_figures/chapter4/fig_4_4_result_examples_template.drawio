<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.4 – Minh họa kết quả OCR trên một số nhóm tài liệu  (khung trình bày)" id="fig_4_4_result_examples_template"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.4 – Minh họa kết quả OCR trên một số nhóm tài liệu  (khung trình bày)" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="KHUNG TRÌNH BÀY — không tái hiện bất kỳ kết quả OCR nào ở đây. Các ô chỉ nêu tên tệp mẫu đã có trong kho mã nguồn và vị trí cần chèn ảnh chụp." style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="warn" value="Hình này không thể sinh ra từ mã nguồn vì nó trình bày kết quả nhận dạng trên tài liệu thật. Khung dưới đây liệt kê tài liệu mẫu đã có sẵn trong kho để việc chụp ảnh được nhất quán. Không dùng lại các kết quả tham chiếu đã lưu như thể chúng là kết quả do hệ thống này chạy ra, nếu chưa chạy lại." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1320" height="58" as="geometry"/></mxCell><mxCell id="c1_h" value="a)  Văn bản in rõ nét" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c1_s" value="Tệp nguồn trong kho&lt;br&gt;glm-ocr-server/examples/source/page.png&lt;br&gt;&lt;br&gt;Kết quả tham chiếu GLM-OCR đã có&lt;br&gt;examples/result/page/page.json · page.md&lt;br&gt;layout_vis/layout_page0.jpg" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c1_l" value="CHÈN ẢNH CHỤP&lt;br&gt;&lt;br&gt;trái: tài liệu gốc&lt;br&gt;phải: kết quả OCR do hệ thống&lt;br&gt;này tạo ra&lt;br&gt;&lt;br&gt;đánh dấu hai đến ba vị trí đúng&lt;br&gt;và sai trên ảnh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c1_c" value="Nội dung chú thích cần ghi&lt;br&gt;• công cụ đã dùng (selected_engine)&lt;br&gt;• thời gian xử lý trang (processing_time_ms)&lt;br&gt;• số vùng / độ tin cậy trung bình&lt;br&gt;• loại lỗi cụ thể quan sát được" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="c2_h" value="b)  Bảng biểu / bố cục có cấu trúc" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c2_s" value="Tệp nguồn trong kho&lt;br&gt;glm-ocr-server/examples/source/table.png&lt;br&gt;&lt;br&gt;Kết quả tham chiếu GLM-OCR đã có&lt;br&gt;examples/result/table/table.json · table.md&lt;br&gt;và ui/_runs/0359de69/ (lần chạy đã ghi)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="380" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c2_l" value="CHÈN ẢNH CHỤP&lt;br&gt;&lt;br&gt;trái: tài liệu gốc&lt;br&gt;phải: kết quả OCR do hệ thống&lt;br&gt;này tạo ra&lt;br&gt;&lt;br&gt;đánh dấu hai đến ba vị trí đúng&lt;br&gt;và sai trên ảnh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="380" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c2_c" value="Nội dung chú thích cần ghi&lt;br&gt;• công cụ đã dùng (selected_engine)&lt;br&gt;• thời gian xử lý trang (processing_time_ms)&lt;br&gt;• số vùng / độ tin cậy trung bình&lt;br&gt;• loại lỗi cụ thể quan sát được" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="380" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="c3_h" value="c)  Chữ viết tay  (trường hợp khó)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c3_s" value="Tệp nguồn trong kho&lt;br&gt;glm-ocr-server/examples/source/handwritten.png&lt;br&gt;&lt;br&gt;Kết quả tham chiếu GLM-OCR đã có&lt;br&gt;examples/result/handwritten/handwritten.json · .md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="720" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c3_l" value="CHÈN ẢNH CHỤP&lt;br&gt;&lt;br&gt;trái: tài liệu gốc&lt;br&gt;phải: kết quả OCR do hệ thống&lt;br&gt;này tạo ra&lt;br&gt;&lt;br&gt;đánh dấu hai đến ba vị trí đúng&lt;br&gt;và sai trên ảnh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="720" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c3_c" value="Nội dung chú thích cần ghi&lt;br&gt;• công cụ đã dùng (selected_engine)&lt;br&gt;• thời gian xử lý trang (processing_time_ms)&lt;br&gt;• số vùng / độ tin cậy trung bình&lt;br&gt;• loại lỗi cụ thể quan sát được" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="720" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="c4_h" value="d)  Ảnh chụp chất lượng thấp  —  CÒN THIẾU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="176" width="300" height="44" as="geometry"/></mxCell><mxCell id="c4_s" value="Kho mã nguồn không có ảnh chụp chất lượng thấp nào.&lt;br&gt;Cần bổ sung một ảnh chụp thật do tác giả tạo và&lt;br&gt;tải lên qua ứng dụng.&lt;br&gt;&lt;br&gt;Báo cáo yêu cầu ít nhất một trường hợp khó nên không&lt;br&gt;thể bỏ qua mẫu này." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="232" width="300" height="130" as="geometry"/></mxCell><mxCell id="c4_l" value="CHÈN ẢNH CHỤP&lt;br&gt;&lt;br&gt;trái: tài liệu gốc&lt;br&gt;phải: kết quả OCR do hệ thống&lt;br&gt;này tạo ra&lt;br&gt;&lt;br&gt;đánh dấu hai đến ba vị trí đúng&lt;br&gt;và sai trên ảnh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="376" width="300" height="190" as="geometry"/></mxCell><mxCell id="c4_c" value="Nội dung chú thích cần ghi&lt;br&gt;• công cụ đã dùng (selected_engine)&lt;br&gt;• thời gian xử lý trang (processing_time_ms)&lt;br&gt;• số vùng / độ tin cậy trung bình&lt;br&gt;• loại lỗi cụ thể quan sát được" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="580" width="300" height="96" as="geometry"/></mxCell><mxCell id="n1" value="Cách chụp lại từng ảnh một cách tái lặp được: tải tệp mẫu lên qua POST /api/upload, chạy OCR với một công cụ đã chỉ định rõ, rồi dùng màn hình làm việc OCR để đặt ảnh trang (có hiển thị khung bao nhận dạng) cạnh thẻ Markdown hoặc Raw. Các giá trị cần cho chú thích đều hiện trên dải thống kê và cũng được ghi vào activity_logs, nhờ đó hình và phần thuyết minh luôn khớp nhau." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1320" height="84" as="geometry"/></mxCell><mxCell id="n2" value="Yêu cầu trung thực đã nêu trong báo cáo: phải có ít nhất một trường hợp khó, và không được chỉ chọn các ví dụ cho kết quả đẹp. Kho mã nguồn cung cấp ba mẫu dùng được; ảnh chụp chất lượng thấp phải do tác giả tự bổ sung." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>