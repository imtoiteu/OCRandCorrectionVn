<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.1 – Bố trí các thành phần trong môi trường thử nghiệm" id="fig_4_1_test_environment"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.1 – Bố trí các thành phần trong môi trường thử nghiệm" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Sơ đồ bố trí và những điểm mà hệ thống sinh ra dữ liệu quan sát được trong một lần chạy thử" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="mach" value="Máy thử nghiệm  —  macOS Apple Silicon · Python 3.10  (RUN_MACOS.md)" style="swimlane;rounded=1;arcSize=4;startSize=38;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFF5EB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="900" height="660" as="geometry"/></mxCell><mxCell id="obs" value="Dữ liệu quan sát do hệ thống sinh ra" style="swimlane;rounded=1;arcSize=4;startSize=36;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFAEB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="980" y="274" width="380" height="478" as="geometry"/></mxCell><mxCell id="br" value="Máy khách thử nghiệm — trình duyệt web&lt;br&gt;http://localhost:5001&lt;br&gt;tài khoản khởi tạo sẵn: user / user123 · admin / admin123" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="58" width="400" height="84" as="geometry"/></mxCell><mxCell id="flask" value="Ứng dụng Flask SmartDocs  —  cổng 5001  (một tiến trình, máy chủ phát triển đa luồng)&lt;br&gt;xác thực · kiểm tra quyền sở hữu · tuyến OCR · thư viện tài liệu · trang quản trị · API hiệu chỉnh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="mach"><mxGeometry x="24" y="172" width="852" height="76" as="geometry"/></mxCell><mxCell id="eng" value="Công cụ OCR chạy trong tiến trình&lt;br&gt;PaddleOCR PP-OCRv5&lt;br&gt;PP-StructureV3 + PP-OCRv6_medium&lt;br&gt;VietOCR vgg_transformer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="278" width="412" height="92" as="geometry"/></mxCell><mxCell id="glm" value="Nhánh GLM-OCR (tùy chọn)&lt;br&gt;glmocr CLI trong .venv-sdk (mỗi yêu cầu)&lt;br&gt;→ máy chủ MLX :8080 trong .venv-mlx&lt;br&gt;mô hình mlx-community/GLM-OCR-bf16" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="464" y="278" width="412" height="92" as="geometry"/></mxCell><mxCell id="db" value="SQLite  paddleocr.db&lt;br&gt;users · documents&lt;br&gt;document_artifacts&lt;br&gt;activity_logs" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="400" width="264" height="88" as="geometry"/></mxCell><mxCell id="up" value="uploads/&lt;br&gt;tài liệu gốc&lt;br&gt;+ tệp .png tạm của trang&lt;br&gt;MAX_UPLOAD_MB = 50" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="308" y="400" width="264" height="88" as="geometry"/></mxCell><mxCell id="mm" value="models/ · bộ nhớ đệm HF · PaddleX&lt;br&gt;trọng số VietOCR&lt;br&gt;cờ OFFLINE quyết định việc tải về" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="592" y="400" width="284" height="88" as="geometry"/></mxCell><mxCell id="smp" value="Tài liệu thử nghiệm đã có sẵn trong kho mã nguồn&lt;br&gt;glm-ocr-server/examples/source/     page.png · paper.png · table.png · seal.png · code.png · handwritten.png · GLM-4.5V.pdf&lt;br&gt;glm-ocr-server/examples/result/&lt;tên&gt;/     &lt;tên&gt;.json · &lt;tên&gt;.md · layout_vis/ · imgs/   (kết quả tham chiếu của GLM-OCR)&lt;br&gt;glm-ocr-server/ui/_runs/&lt;id&gt;/     input/ · output/ · tệp .zip kết quả   (các lần chạy GLM-OCR đã ghi lại)&lt;br&gt;vi-correction-prototype/tests/correction/sample_receipt_glm.json   (JSON OCR có cấu trúc cho pipeline hiệu chỉnh)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="516" width="852" height="116" as="geometry"/></mxCell><mxCell id="lan" value="Máy khách thứ hai (tùy chọn)&lt;br&gt;Một máy khác trong cùng mạng nội bộ;&lt;br&gt;kết nối được vì cfg.HOST = 0.0.0.0.&lt;br&gt;Mã nguồn không có chế độ máy chủ từ xa —&lt;br&gt;trình duyệt là máy khách từ xa duy nhất." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="380" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Thời gian xử lý từng trang&lt;br&gt;elapsed_ms của bộ thích nghi → trường&lt;br&gt;processing_time_ms trong phản hồi" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="obs"><mxGeometry x="22" y="48" width="336" height="74" as="geometry"/></mxCell><mxCell id="o2" value="Công cụ thực sự đã dùng&lt;br&gt;selected_engine · ocr_engine&lt;br&gt;(ghi theo từng trang trong phản hồi)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="obs"><mxGeometry x="22" y="132" width="336" height="74" as="geometry"/></mxCell><mxCell id="o3" value="inference_status&lt;br&gt;ok | error |&lt;br&gt;fallback_to_paddle_for_pdf" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="obs"><mxGeometry x="22" y="216" width="336" height="74" as="geometry"/></mxCell><mxCell id="o4" value="Bản ghi activity_logs (action = ocr)&lt;br&gt;trường detail chứa chế độ, công cụ,&lt;br&gt;processing_time_ms, inference_status,&lt;br&gt;số trang — xem tại /admin/logs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="obs"><mxGeometry x="22" y="300" width="336" height="84" as="geometry"/></mxCell><mxCell id="o5" value="document_artifacts&lt;br&gt;kết quả từng lần chạy được lưu lại,&lt;br&gt;so sánh được giữa các công cụ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="obs"><mxGeometry x="22" y="394" width="336" height="70" as="geometry"/></mxCell><mxCell id="n1" value="Toàn bộ thành phần trong hình chạy trên một máy. Trình duyệt không bao giờ liên hệ trực tiếp với máy chủ mô hình MLX hay cơ sở dữ liệu: điểm truy cập mạng duy nhất mở cho người kiểm thử là Flask ở cổng 5001, còn cổng 8080 chỉ được tiến trình con glmocr gọi tới qua localhost." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="1320" height="62" as="geometry"/></mxCell><mxCell id="n2" value="Hạn chế của môi trường thử nghiệm cần nêu trong báo cáo: ứng dụng chạy trên máy chủ phát triển của Flask (một tiến trình, đa luồng), cơ sở dữ liệu là một tệp SQLite cục bộ, và công cụ GLM-OCR chỉ dùng được trên Apple Silicon khi đã cài đủ hai môi trường ảo và máy chủ MLX đang chạy. Trên máy không có các điều kiện đó, hộp chọn công cụ vẫn hiện &quot;Recommended&quot; nhưng yêu cầu sẽ trả về lỗi có cấu trúc thay vì kết quả." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="1320" height="76" as="geometry"/></mxCell><mxCell id="e0" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="br" target="flask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="HTTP qua mạng nội bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lan" target="flask"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="256"/><mxPoint x="950" y="256"/><mxPoint x="950" y="300"/></Array></mxGeometry></mxCell><mxCell id="e2" value="trong tiến trình" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="eng"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="352"/><mxPoint x="270" y="352"/></Array></mxGeometry></mxCell><mxCell id="e3" value="tiến trình con + HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="glm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="352"/><mxPoint x="710" y="352"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eng" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eng" target="up"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="glm" target="mm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D6B656;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="964" y="302"/><mxPoint x="964" y="513"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>