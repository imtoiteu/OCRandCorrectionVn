<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.3 – Một số bước kiểm thử chức năng xử lý tài liệu" id="fig_4_3_functional_test_steps"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.3 – Một số bước kiểm thử chức năng xử lý tài liệu" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1340" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Quy trình kiểm thử chức năng rút ra từ luồng xử lý đã hiện thực hóa; mỗi bước ghi rõ lời gọi API và dữ liệu quan sát được mà hệ thống sinh ra" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1340" height="20" as="geometry"/></mxCell><mxCell id="h1" value="Bước kiểm thử" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="38" as="geometry"/></mxCell><mxCell id="h2" value="Thao tác và lời gọi API được kiểm tra" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="480" height="38" as="geometry"/></mxCell><mxCell id="h3" value="Dữ liệu quan sát do hệ thống sinh ra" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="520" height="38" as="geometry"/></mxCell><mxCell id="s1_t" value="a)  Đăng nhập" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="300" height="76" as="geometry"/></mxCell><mxCell id="s1_a" value="Mở http://localhost:5001 → mọi yêu cầu chưa xác thực&lt;br&gt;đều được trả về biểu mẫu đăng nhập.&lt;br&gt;POST /login  (user / user123)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="152" width="480" height="76" as="geometry"/></mxCell><mxCell id="s1_e" value="Quan sát: chuyển hướng về /, thanh điều hướng hiện tên&lt;br&gt;và vai trò người dùng; activity_logs thêm action = &quot;login&quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="152" width="520" height="76" as="geometry"/></mxCell><mxCell id="s2_t" value="b)  Tải tài liệu lên" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="300" height="76" as="geometry"/></mxCell><mxCell id="s2_a" value="Màn hình OCR → vùng kéo thả hoặc hộp chọn tệp.&lt;br&gt;POST /api/upload  (multipart)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="238" width="480" height="76" as="geometry"/></mxCell><mxCell id="s2_e" value="Quan sát: mã 200 kèm file_id, page_count, is_pdf;&lt;br&gt;tệp xuất hiện trong uploads/ dạng {uuid}{suffix};&lt;br&gt;bản ghi Document có status = &quot;uploaded&quot;; nhật ký action = &quot;upload&quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="238" width="520" height="76" as="geometry"/></mxCell><mxCell id="s3_t" value="c)  Xem trước và chuyển trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="300" height="76" as="geometry"/></mxCell><mxCell id="s3_a" value="POST /api/ocr/page với preview_only = true&lt;br&gt;(nút chuyển trang khi tài liệu là PDF)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="324" width="480" height="76" as="geometry"/></mxCell><mxCell id="s3_e" value="Quan sát: page_image_b64 được vẽ lên canvas,&lt;br&gt;results = [], chưa chạy OCR, chưa ghi kết xuất nào." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="324" width="520" height="76" as="geometry"/></mxCell><mxCell id="s4_t" value="d)  Lựa chọn công cụ OCR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="300" height="76" as="geometry"/></mxCell><mxCell id="s4_a" value="Hộp thả xuống: Recommended (glmocr) ·&lt;br&gt;GLM Layout + VietOCR Text · Vietnamese (vietocr) ·&lt;br&gt;Standard (paddleocr)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="410" width="480" height="76" as="geometry"/></mxCell><mxCell id="s4_e" value="Quan sát: giá trị đã chọn được gửi trong trường &quot;engine&quot;&lt;br&gt;và trả về trong selected_engine;&lt;br&gt;lựa chọn được giữ trong suốt phiên làm việc." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="410" width="520" height="76" as="geometry"/></mxCell><mxCell id="s5_t" value="e)  Chạy nhận dạng và theo dõi trạng thái" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="496" width="300" height="76" as="geometry"/></mxCell><mxCell id="s5_a" value="POST /api/ocr/page  (Run OCR)  hoặc&lt;br&gt;POST /api/ocr/all  (OCR All) · nút Stop hủy lời gọi&lt;br&gt;fetch ở phía trình duyệt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="496" width="480" height="76" as="geometry"/></mxCell><mxCell id="s5_e" value="Quan sát: processing_time_ms và inference_status theo từng&lt;br&gt;trang; dải thống kê hiện số vùng, độ tin cậy trung bình,&lt;br&gt;thời gian và số trang; nhật ký action = &quot;ocr&quot; kèm chi tiết." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="496" width="520" height="76" as="geometry"/></mxCell><mxCell id="s6_t" value="f)  Kiểm tra các dạng biểu diễn kết quả" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="300" height="76" as="geometry"/></mxCell><mxCell id="s6_a" value="Các thẻ kết quả: Markdown · Raw · Images · JSON;&lt;br&gt;bấm vào một vùng sẽ làm nổi bật khung bao&lt;br&gt;tương ứng trên ảnh trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="582" width="480" height="76" as="geometry"/></mxCell><mxCell id="s6_e" value="Quan sát: các kết xuất ocr, ocr_layout, ocr_json,&lt;br&gt;ocr_markdown, ocr_images được ghi vào document_artifacts&lt;br&gt;(mỗi loại một bản ghi, ghi đè khi chạy lại)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="582" width="520" height="76" as="geometry"/></mxCell><mxCell id="s7_t" value="g)  Kết xuất kết quả" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="300" height="76" as="geometry"/></mxCell><mxCell id="s7_a" value="Tải về .md / .txt / .json;&lt;br&gt;POST /api/ocr/export-docx  (pandoc)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="668" width="480" height="76" as="geometry"/></mxCell><mxCell id="s7_e" value="Quan sát: tệp được tải xuống; nếu thiếu pandoc thì trả về&lt;br&gt;501 kèm thông báo giải thích thay vì báo lỗi chung." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="668" width="520" height="76" as="geometry"/></mxCell><mxCell id="s8_t" value="h)  Mở lại từ thư viện tài liệu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="754" width="300" height="76" as="geometry"/></mxCell><mxCell id="s8_a" value="#documents → mở một tài liệu →&lt;br&gt;#ocr/&lt;file_id&gt; → GET /api/documents/&lt;id&gt;/text&lt;br&gt;và /ocr-images" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="754" width="480" height="76" as="geometry"/></mxCell><mxCell id="s8_e" value="Quan sát: kết quả OCR trước đó, khung bao và ảnh minh họa&lt;br&gt;được khôi phục mà không phải chạy lại OCR." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="754" width="520" height="76" as="geometry"/></mxCell><mxCell id="s9_t" value="i)  Tùy chọn — hiệu chỉnh tiếng Việt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="300" height="76" as="geometry"/></mxCell><mxCell id="s9_a" value="GET /correction → chọn tài liệu đã có ocr_json →&lt;br&gt;POST /api/correction/run → POST /api/correction/save" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="840" width="480" height="76" as="geometry"/></mxCell><mxCell id="s9_e" value="Quan sát: số liệu đếm, thời gian và báo cáo kiểm tra;&lt;br&gt;corrected_json / corrected_md được lưu song song, không&lt;br&gt;bao giờ ghi đè kết xuất OCR gốc." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="840" width="520" height="76" as="geometry"/></mxCell><mxCell id="s10_t" value="j)  Kiểm tra chức năng quản trị" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="300" height="76" as="geometry"/></mxCell><mxCell id="s10_a" value="/admin/ tổng quan · /admin/users · /admin/logs ·&lt;br&gt;/admin/files   (admin / admin123)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="926" width="480" height="76" as="geometry"/></mxCell><mxCell id="s10_e" value="Quan sát: mọi thao tác ở trên đều xuất hiện trong danh sách&lt;br&gt;nhật ký; tài khoản thường truy cập các URL đó sẽ nhận 403." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="926" width="520" height="76" as="geometry"/></mxCell><mxCell id="n1" value="Ghi chú về ảnh chụp: phần thuyết minh trình bày Hình 4.3 dưới dạng các ảnh a) tải tệp, b) lựa chọn công cụ OCR, c) kết quả nhận dạng, d) lịch sử xử lý — xem MANUAL_COMPLETION.md." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="1024" width="1340" height="44" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_t" target="s2_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2_t" target="s3_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_t" target="s4_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4_t" target="s5_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5_t" target="s6_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6_t" target="s7_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7_t" target="s8_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8_t" target="s9_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9_t" target="s10_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>