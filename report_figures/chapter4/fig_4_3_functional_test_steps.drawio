<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.3 – Một số bước kiểm thử chức năng xử lý tài liệu" id="fig_4_3_functional_test_steps"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.3 – Một số bước kiểm thử chức năng xử lý tài liệu" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1340" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Functional test procedure derived from the implemented request flow; each step lists the API call and the evidence the system produces" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1340" height="20" as="geometry"/></mxCell><mxCell id="h1" value="Test step" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="38" as="geometry"/></mxCell><mxCell id="h2" value="Action performed and API call exercised" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="480" height="38" as="geometry"/></mxCell><mxCell id="h3" value="Evidence produced by the implementation" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="520" height="38" as="geometry"/></mxCell><mxCell id="s1_t" value="a)  Log in" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="300" height="76" as="geometry"/></mxCell><mxCell id="s1_a" value="Open http://localhost:5001 → the login form is served&lt;br&gt;for any unauthenticated request.&lt;br&gt;POST /login  (user / user123)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="152" width="480" height="76" as="geometry"/></mxCell><mxCell id="s1_e" value="Evidence: redirect to /, navigation bar shows the user&lt;br&gt;name and role; activity_logs gains action = &quot;login&quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="152" width="520" height="76" as="geometry"/></mxCell><mxCell id="s2_t" value="b)  Upload a document" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="300" height="76" as="geometry"/></mxCell><mxCell id="s2_a" value="OCR view → drop zone or file picker.&lt;br&gt;POST /api/upload  (multipart)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="238" width="480" height="76" as="geometry"/></mxCell><mxCell id="s2_e" value="Evidence: 200 with file_id, page_count, is_pdf;&lt;br&gt;file appears in uploads/ as {uuid}{suffix};&lt;br&gt;Document row status = &quot;uploaded&quot;; log action = &quot;upload&quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="238" width="520" height="76" as="geometry"/></mxCell><mxCell id="s3_t" value="c)  Preview and navigate pages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="300" height="76" as="geometry"/></mxCell><mxCell id="s3_a" value="POST /api/ocr/page with preview_only = true&lt;br&gt;(page navigation buttons for a PDF)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="324" width="480" height="76" as="geometry"/></mxCell><mxCell id="s3_e" value="Evidence: page_image_b64 rendered on the canvas,&lt;br&gt;results = [], no OCR performed, no artifact written." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="324" width="520" height="76" as="geometry"/></mxCell><mxCell id="s4_t" value="d)  Select the OCR tool" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="300" height="76" as="geometry"/></mxCell><mxCell id="s4_a" value="Engine drop-down: Recommended (glmocr) ·&lt;br&gt;GLM Layout + VietOCR Text · Vietnamese (vietocr) ·&lt;br&gt;Standard (paddleocr)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="410" width="480" height="76" as="geometry"/></mxCell><mxCell id="s4_e" value="Evidence: the chosen value is sent as the &quot;engine&quot;&lt;br&gt;field and echoed back as selected_engine;&lt;br&gt;the choice is kept for the whole session." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="410" width="520" height="76" as="geometry"/></mxCell><mxCell id="s5_t" value="e)  Run recognition and follow the status" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="496" width="300" height="76" as="geometry"/></mxCell><mxCell id="s5_a" value="POST /api/ocr/page  (Run OCR)  or&lt;br&gt;POST /api/ocr/all  (OCR All) · Stop button aborts&lt;br&gt;the fetch on the client side" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="496" width="480" height="76" as="geometry"/></mxCell><mxCell id="s5_e" value="Evidence: processing_time_ms and inference_status per&lt;br&gt;page; statistics strip shows regions, mean confidence,&lt;br&gt;time and page count; log action = &quot;ocr&quot; with details." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="496" width="520" height="76" as="geometry"/></mxCell><mxCell id="s6_t" value="f)  Inspect the result representations" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="300" height="76" as="geometry"/></mxCell><mxCell id="s6_a" value="Result tabs: Markdown · Raw · Images · JSON;&lt;br&gt;clicking a region highlights the matching box&lt;br&gt;on the page canvas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="582" width="480" height="76" as="geometry"/></mxCell><mxCell id="s6_e" value="Evidence: artifacts ocr, ocr_layout, ocr_json,&lt;br&gt;ocr_markdown, ocr_images written to document_artifacts&lt;br&gt;(one row per kind, upserted)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="582" width="520" height="76" as="geometry"/></mxCell><mxCell id="s7_t" value="g)  Export the result" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="300" height="76" as="geometry"/></mxCell><mxCell id="s7_a" value="Download .md / .txt / .json;&lt;br&gt;POST /api/ocr/export-docx  (pandoc)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="668" width="480" height="76" as="geometry"/></mxCell><mxCell id="s7_e" value="Evidence: files downloaded; a missing pandoc returns&lt;br&gt;501 with an explanatory message rather than failing." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="668" width="520" height="76" as="geometry"/></mxCell><mxCell id="s8_t" value="h)  Reopen from the document library" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="754" width="300" height="76" as="geometry"/></mxCell><mxCell id="s8_a" value="#documents → open a document →&lt;br&gt;#ocr/&lt;file_id&gt; → GET /api/documents/&lt;id&gt;/text&lt;br&gt;and /ocr-images" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="754" width="480" height="76" as="geometry"/></mxCell><mxCell id="s8_e" value="Evidence: the previous OCR result, overlay boxes and&lt;br&gt;images are restored without re-running OCR." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="754" width="520" height="76" as="geometry"/></mxCell><mxCell id="s9_t" value="i)  Optional — Vietnamese correction" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="300" height="76" as="geometry"/></mxCell><mxCell id="s9_a" value="GET /correction → pick a document that has ocr_json →&lt;br&gt;POST /api/correction/run → POST /api/correction/save" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="840" width="480" height="76" as="geometry"/></mxCell><mxCell id="s9_e" value="Evidence: counts, timing and a validation report;&lt;br&gt;corrected_json / corrected_md stored beside — never&lt;br&gt;overwriting — the raw OCR artifacts." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="840" width="520" height="76" as="geometry"/></mxCell><mxCell id="s10_t" value="j)  Administration checks" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="300" height="76" as="geometry"/></mxCell><mxCell id="s10_a" value="/admin/ dashboard · /admin/users · /admin/logs ·&lt;br&gt;/admin/files   (admin / admin123)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="360" y="926" width="480" height="76" as="geometry"/></mxCell><mxCell id="s10_e" value="Evidence: every action above appears in the log list;&lt;br&gt;a non-admin account receives 403 from the same URLs." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="860" y="926" width="520" height="76" as="geometry"/></mxCell><mxCell id="n1" value="Screenshot note: the report presents Figure 4.3 as captures a) upload, b) engine selection, c) recognition result, d) processing history — see MANUAL_COMPLETION.md." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="1024" width="1340" height="44" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_t" target="s2_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2_t" target="s3_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_t" target="s4_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4_t" target="s5_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5_t" target="s6_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6_t" target="s7_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7_t" target="s8_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8_t" target="s9_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9_t" target="s10_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>