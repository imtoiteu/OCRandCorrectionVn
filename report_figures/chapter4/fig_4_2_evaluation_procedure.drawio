<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.2 – Quy trình chuẩn bị dữ liệu và đánh giá kết quả OCR" id="fig_4_2_evaluation_procedure"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.2 – Quy trình chuẩn bị dữ liệu và đánh giá kết quả OCR" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1340" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Filled boxes are supported by code or data in the repository; red-outlined boxes are NOT implemented and must be done manually" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1340" height="20" as="geometry"/></mxCell><mxCell id="prep" value="Data preparation" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#EFF6EE;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="660" height="476" as="geometry"/></mxCell><mxCell id="meas" value="Measurement and scoring" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#B0E3E6;strokeColor=#0E8088;swimlaneFillColor=#E0F4F5;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="156" width="640" height="476" as="geometry"/></mxCell><mxCell id="agg" value="Aggregation and reporting" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFAEB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="1340" height="218" as="geometry"/></mxCell><mxCell id="leg" value="LEGEND      coloured fill = implemented in the repository (the responsible file is named in the box)            red outline on white = no implementation exists — the step must be performed manually" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1340" height="44" as="geometry"/></mxCell><mxCell id="p1" value="Select the documents to evaluate&lt;br&gt;Samples available in the repository:&lt;br&gt;examples/source/*.png · GLM-4.5V.pdf" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="48" width="616" height="62" as="geometry"/></mxCell><mxCell id="p2" value="Group them by document type&lt;br&gt;printed page · scientific paper · table ·&lt;br&gt;seal · source code · handwriting" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="124" width="616" height="62" as="geometry"/></mxCell><mxCell id="p3" value="Upload each document through the SPA&lt;br&gt;POST /api/upload → Document row +&lt;br&gt;uploads/{uuid}{suffix}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="200" width="616" height="58" as="geometry"/></mxCell><mxCell id="p4" value="Run OCR once per engine on the same file&lt;br&gt;engine parameter of /api/ocr/page and&lt;br&gt;/api/ocr/all (drop-down or API)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="272" width="616" height="62" as="geometry"/></mxCell><mxCell id="p5" value="Results are persisted automatically&lt;br&gt;document_artifacts: ocr, ocr_json,&lt;br&gt;ocr_markdown, ocr_layout, ocr_images" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="348" width="616" height="62" as="geometry"/></mxCell><mxCell id="p6" value="Optional: run the Vietnamese correction&lt;br&gt;POST /api/correction/run → corrected_json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="424" width="616" height="44" as="geometry"/></mxCell><mxCell id="m1" value="AUTOMATIC — processing time&lt;br&gt;Every adapter records elapsed_ms; app.py copies it to processing_time_ms and&lt;br&gt;writes it into the activity_logs detail string for each page and for OCR-All." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="48" width="596" height="68" as="geometry"/></mxCell><mxCell id="m2" value="AUTOMATIC — recognition metadata&lt;br&gt;region count, mean confidence (PaddleOCR engines only), page count,&lt;br&gt;inference_status and the engine actually used are returned with every response." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="128" width="596" height="68" as="geometry"/></mxCell><mxCell id="m3" value="AUTOMATIC — correction quality signals (vi_correction)&lt;br&gt;counts {blocks, units, sent, changed, skipped} · timing {provider_seconds,&lt;br&gt;total_seconds} · validation report (structure preserved, placeholders intact)&lt;br&gt;plus scripts/bench_spans.py for per-span latency in the prototype." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="208" width="596" height="76" as="geometry"/></mxCell><mxCell id="m4" value="MANUAL — create the ground truth&lt;br&gt;No transcription, annotation tool or reference-text file for the Vietnamese&lt;br&gt;corpus exists in the repository." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="296" width="596" height="62" as="geometry"/></mxCell><mxCell id="m5" value="MANUAL — text normalisation before scoring&lt;br&gt;No normalisation routine for evaluation exists in the repository." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="370" width="596" height="46" as="geometry"/></mxCell><mxCell id="m6" value="MANUAL — compute CER and WER (no implementation exists: no jiwer, no edit-distance code)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="428" width="596" height="40" as="geometry"/></mxCell><mxCell id="g1" value="Export the raw evidence&lt;br&gt;/admin/logs (activity_logs, filterable) ·&lt;br&gt;/api/documents/&lt;id&gt;/text (all artifacts) ·&lt;br&gt;downloads .md / .txt / .json / .docx" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="22" y="48" width="420" height="68" as="geometry"/></mxCell><mxCell id="g2" value="MANUAL — build the comparison tables&lt;br&gt;Accuracy per document group and engine;&lt;br&gt;no aggregation script exists in the repository." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="462" y="48" width="420" height="68" as="geometry"/></mxCell><mxCell id="g3" value="MANUAL — build the timing chart (Figure 4.5)&lt;br&gt;Separate the first-run model-loading time from the&lt;br&gt;steady-state time, as the report requires." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="902" y="48" width="416" height="68" as="geometry"/></mxCell><mxCell id="g4" value="Regression / smoke tests that do exist&lt;br&gt;glm-ocr-ui: test_layout.py · test_regression.py (reading-order reconstruction) · test_vietocr.py · test_refactored_ocr.py (engine dispatch) · test_markdown_normalize.py (pytest)&lt;br&gt;glm-ocr-server: glmocr/tests/test_unit.py · test_integration.py (pytest, with conftest.py)   —   none of these measures OCR accuracy; they verify behaviour, not quality." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="22" y="132" width="1296" height="68" as="geometry"/></mxCell><mxCell id="warn" value="ACCURACY NOTICE — the repository contains no OCR accuracy evaluation. There is no ground-truth data set, no CER/WER or layout-accuracy implementation (a repository-wide search for CER, WER, jiwer, levenshtein and edit_distance returns nothing outside model vocabulary files), and no recorded measurement results. tools/eval_model.py and tools/ab_harness.py evaluate candidate Qwen chat/rewrite language models, not OCR, and they import services that no longer exist in this build. Everything drawn as a red-outlined box must be produced manually before Chapter 4 can report numbers." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="1340" height="96" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="602"/><mxPoint x="716" y="238"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#B85450;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m6" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>