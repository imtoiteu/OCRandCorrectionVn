<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.2 – Quy trình chuẩn bị dữ liệu và đánh giá kết quả OCR" id="fig_4_2_evaluation_procedure"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.2 – Quy trình chuẩn bị dữ liệu và đánh giá kết quả OCR" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1340" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Khối tô màu là bước đã có mã hoặc dữ liệu trong kho; khối viền đỏ nền trắng là bước CHƯA hiện thực hóa, phải làm thủ công" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1340" height="20" as="geometry"/></mxCell><mxCell id="prep" value="Chuẩn bị dữ liệu" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#EFF6EE;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="660" height="476" as="geometry"/></mxCell><mxCell id="meas" value="Đo đạc và chấm điểm" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#B0E3E6;strokeColor=#0E8088;swimlaneFillColor=#E0F4F5;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="156" width="640" height="476" as="geometry"/></mxCell><mxCell id="agg" value="Tổng hợp và báo cáo" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFAEB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="1340" height="218" as="geometry"/></mxCell><mxCell id="leg" value="CHÚ GIẢI      khối tô màu = đã hiện thực hóa trong kho mã nguồn (có ghi tệp chịu trách nhiệm)            khối viền đỏ nền trắng = chưa có mã, phải thực hiện thủ công" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1340" height="44" as="geometry"/></mxCell><mxCell id="p1" value="Chọn tài liệu để đánh giá&lt;br&gt;Mẫu có sẵn trong kho mã nguồn:&lt;br&gt;examples/source/*.png · GLM-4.5V.pdf" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="48" width="616" height="62" as="geometry"/></mxCell><mxCell id="p2" value="Phân nhóm theo loại tài liệu&lt;br&gt;văn bản in · bài báo khoa học · bảng biểu ·&lt;br&gt;con dấu · mã nguồn · chữ viết tay" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="124" width="616" height="62" as="geometry"/></mxCell><mxCell id="p3" value="Tải từng tài liệu lên qua SPA&lt;br&gt;POST /api/upload → bản ghi Document +&lt;br&gt;uploads/{uuid}{suffix}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="200" width="616" height="58" as="geometry"/></mxCell><mxCell id="p4" value="Chạy OCR lần lượt bằng từng công cụ trên cùng tệp&lt;br&gt;tham số engine của /api/ocr/page và&lt;br&gt;/api/ocr/all (hộp chọn hoặc API)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="272" width="616" height="62" as="geometry"/></mxCell><mxCell id="p5" value="Kết quả được lưu tự động&lt;br&gt;document_artifacts: ocr, ocr_json,&lt;br&gt;ocr_markdown, ocr_layout, ocr_images" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="348" width="616" height="62" as="geometry"/></mxCell><mxCell id="p6" value="Tùy chọn: chạy hiệu chỉnh tiếng Việt&lt;br&gt;POST /api/correction/run → corrected_json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="prep"><mxGeometry x="22" y="424" width="616" height="44" as="geometry"/></mxCell><mxCell id="m1" value="TỰ ĐỘNG — thời gian xử lý&lt;br&gt;Mọi bộ thích nghi đều ghi elapsed_ms; app.py chép sang processing_time_ms và&lt;br&gt;ghi vào chuỗi detail của activity_logs cho từng trang cũng như cho lần OCR toàn bộ." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="48" width="596" height="68" as="geometry"/></mxCell><mxCell id="m2" value="TỰ ĐỘNG — thông tin kèm kết quả nhận dạng&lt;br&gt;số vùng, độ tin cậy trung bình (chỉ với công cụ PaddleOCR), số trang,&lt;br&gt;inference_status và công cụ thực sự đã dùng đều trả về cùng mỗi phản hồi." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="128" width="596" height="68" as="geometry"/></mxCell><mxCell id="m3" value="TỰ ĐỘNG — chỉ báo chất lượng hiệu chỉnh (vi_correction)&lt;br&gt;counts {blocks, units, sent, changed, skipped} · timing {provider_seconds,&lt;br&gt;total_seconds} · báo cáo kiểm tra (giữ nguyên cấu trúc, placeholder còn nguyên)&lt;br&gt;kèm scripts/bench_spans.py đo độ trễ theo từng đoạn trong bản thử nghiệm." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="208" width="596" height="76" as="geometry"/></mxCell><mxCell id="m4" value="THỦ CÔNG — tạo dữ liệu chuẩn&lt;br&gt;Kho mã nguồn không có bản gõ lại, công cụ gán nhãn hay tệp văn bản tham&lt;br&gt;chiếu nào cho tập tài liệu tiếng Việt." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="296" width="596" height="62" as="geometry"/></mxCell><mxCell id="m5" value="THỦ CÔNG — chuẩn hóa văn bản trước khi chấm điểm&lt;br&gt;Kho mã nguồn không có hàm chuẩn hóa phục vụ đánh giá." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="370" width="596" height="46" as="geometry"/></mxCell><mxCell id="m6" value="THỦ CÔNG — tính CER và WER (chưa có mã: không có jiwer, không có hàm khoảng cách soạn thảo)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="meas"><mxGeometry x="22" y="428" width="596" height="40" as="geometry"/></mxCell><mxCell id="g1" value="Kết xuất dữ liệu thô&lt;br&gt;/admin/logs (activity_logs, lọc được) ·&lt;br&gt;/api/documents/&lt;id&gt;/text (mọi kết xuất) ·&lt;br&gt;tải về .md / .txt / .json / .docx" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="22" y="48" width="420" height="68" as="geometry"/></mxCell><mxCell id="g2" value="THỦ CÔNG — lập bảng so sánh&lt;br&gt;Độ chính xác theo nhóm tài liệu và theo công cụ;&lt;br&gt;kho mã nguồn không có kịch bản tổng hợp." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="462" y="48" width="420" height="68" as="geometry"/></mxCell><mxCell id="g3" value="THỦ CÔNG — dựng biểu đồ thời gian (Hình 4.5)&lt;br&gt;Tách riêng thời gian nạp mô hình lần đầu khỏi thời&lt;br&gt;gian xử lý ở trạng thái ổn định như báo cáo yêu cầu." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="902" y="48" width="416" height="68" as="geometry"/></mxCell><mxCell id="g4" value="Các kiểm thử hồi quy / kiểm tra nhanh thực sự có trong kho&lt;br&gt;glm-ocr-ui: test_layout.py · test_regression.py (dựng lại thứ tự đọc) · test_vietocr.py · test_refactored_ocr.py (điều phối công cụ) · test_markdown_normalize.py (pytest)&lt;br&gt;glm-ocr-server: glmocr/tests/test_unit.py · test_integration.py (pytest, có conftest.py)   —   không tệp nào trong số đó đo độ chính xác OCR; chúng kiểm tra hành vi chứ không kiểm tra chất lượng." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="agg"><mxGeometry x="22" y="132" width="1296" height="68" as="geometry"/></mxCell><mxCell id="warn" value="CẢNH BÁO VỀ TÍNH CHÍNH XÁC — kho mã nguồn không có phần đánh giá độ chính xác OCR. Không có tập dữ liệu chuẩn, không có phần tính CER/WER hay độ chính xác bố cục (tìm trên toàn kho các từ khóa CER, WER, jiwer, levenshtein và edit_distance đều không ra kết quả nào ngoài các tệp từ vựng của mô hình), và không có kết quả đo nào được lưu lại. tools/eval_model.py và tools/ab_harness.py đánh giá các mô hình ngôn ngữ Qwen dùng cho trò chuyện / viết lại chứ không đánh giá OCR, và chúng còn nạp những dịch vụ không còn tồn tại trong phiên bản này. Mọi khối viền đỏ đều phải làm thủ công trước khi chương 4 có thể nêu số liệu." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="1340" height="96" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="602"/><mxPoint x="716" y="238"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#B85450;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m6" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>