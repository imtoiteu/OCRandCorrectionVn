<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.5 – So sánh thời gian xử lý theo công cụ và số trang  (khung biểu đồ, chưa có dữ liệu)" id="fig_4_5_processing_time_template"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.5 – So sánh thời gian xử lý theo công cụ và số trang  (khung biểu đồ, chưa có dữ liệu)" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="NO MEASUREMENT DATA EXISTS IN THE REPOSITORY — the chart frame is provided empty, together with the procedure for collecting the values" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="warn" value="The repository contains no OCR benchmark results. There is no timing data set, no benchmark script for the OCR engines, and no stored measurement file. tools/eval_results/*.json holds latency figures for candidate Qwen chat/rewrite language models, not for OCR. Plotting anything here without running the measurements would fabricate results, so the chart is delivered as an empty, editable frame." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1320" height="74" as="geometry"/></mxCell><mxCell id="plot" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="140" y="210" width="600" height="390" as="geometry"/></mxCell><mxCell id="nodata" value="NO DATA&lt;br&gt;Draw one series per OCR engine here after running&lt;br&gt;the measurement procedure given below." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="370" width="400" height="70" as="geometry"/></mxCell><mxCell id="ylab" value="Processing time&lt;br&gt;per document&lt;br&gt;(seconds)&lt;br&gt;&lt;br&gt;vertical scale to be&lt;br&gt;set from the measured&lt;br&gt;values" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="110" height="210" as="geometry"/></mxCell><mxCell id="xt0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt1" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt2" value="5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt3" value="10" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt4" value="20" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xlab" value="Number of pages" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="200" height="30" as="geometry"/></mxCell><mxCell id="leg" value="Series — one per OCR engine&lt;br&gt;&lt;br&gt;■  PaddleOCR Legacy      (paddleocr)&lt;br&gt;■  PaddleOCR Modern    (paddleocr_modern)&lt;br&gt;■  VietOCR                        (vietocr)&lt;br&gt;■  GLM-OCR                     (glmocr)&lt;br&gt;■  GLM Layout + VietOCR (glm_vietocr)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="780" y="210" width="300" height="190" as="geometry"/></mxCell><mxCell id="sep" value="Report the first run separately&lt;br&gt;&lt;br&gt;The first request with an engine also loads its model:&lt;br&gt;• PaddleOCR / PP-StructureV3 download and initialise&lt;br&gt;  their pipelines on first use&lt;br&gt;• VietOCR loads the .pth weights&lt;br&gt;• the MLX server holds GLM-OCR resident, but the&lt;br&gt;  glmocr subprocess and PP-DocLayoutV3 start per call&lt;br&gt;&lt;br&gt;Mixing that first measurement into the steady-state&lt;br&gt;curve distorts the scale." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="780" y="418" width="300" height="192" as="geometry"/></mxCell><mxCell id="proc" value="Where the numbers come from&lt;br&gt;(already implemented)&lt;br&gt;&lt;br&gt;1. Each adapter measures its own&lt;br&gt;    wall-clock time and returns&lt;br&gt;    elapsed_ms.&lt;br&gt;&lt;br&gt;2. app.py copies it to&lt;br&gt;    processing_time_ms in the&lt;br&gt;    response for /api/ocr/page.&lt;br&gt;&lt;br&gt;3. For /api/ocr/all the values are&lt;br&gt;    summed and written into the&lt;br&gt;    activity_logs detail string&lt;br&gt;    together with the engine and&lt;br&gt;    the page count.&lt;br&gt;&lt;br&gt;4. /admin/logs lists those rows and&lt;br&gt;    can be filtered by action = &quot;ocr&quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1120" y="210" width="240" height="400" as="geometry"/></mxCell><mxCell id="rec" value="Measurement procedure to run before this figure can be completed&lt;br&gt;&lt;br&gt;1.  Choose a fixed set of documents with 1, 2, 5, 10 and 20 pages and upload each one once.&lt;br&gt;2.  For every engine, warm it up on a throw-away document; record that first measurement separately.&lt;br&gt;3.  Run POST /api/ocr/all with the engine parameter set explicitly, three times per (document, engine) pair.&lt;br&gt;4.  Read processing_time_ms (or the summed value in the activity_logs detail string) and take the median.&lt;br&gt;5.  Record the fixed conditions with the numbers: machine model, cfg.DEVICE, OFFLINE flag, whether the MLX&lt;br&gt;     server was already running, and the exact page size / resolution of the documents.&lt;br&gt;6.  Note that VietOCR falls back to PaddleOCR for PDF input, so its multi-page column measures the fallback." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1320" height="130" as="geometry"/></mxCell><mxCell id="n1" value="Fairness constraint that follows from the implementation: results are cached in memory per (file hash, page, file state, engine), so repeating the same page with the same engine in one server session returns the cached result instead of re-running inference. Restart the application, or use different documents, between repetitions." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="1320" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>