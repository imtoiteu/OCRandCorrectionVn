<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 4.5 – So sánh thời gian xử lý theo công cụ và số trang  (khung biểu đồ, chưa có dữ liệu)" id="fig_4_5_processing_time_template"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 4.5 – So sánh thời gian xử lý theo công cụ và số trang  (khung biểu đồ, chưa có dữ liệu)" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="KHO MÃ NGUỒN KHÔNG CÓ SỐ LIỆU ĐO NÀO — khung biểu đồ được cung cấp ở dạng trống, kèm quy trình thu thập số liệu" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="warn" value="Kho mã nguồn không có kết quả đo hiệu năng OCR. Không có tập số liệu thời gian, không có kịch bản đo cho các công cụ OCR, và không có tệp kết quả đo nào được lưu. Thư mục tools/eval_results/*.json chứa số liệu độ trễ của các mô hình ngôn ngữ Qwen dùng cho trò chuyện / viết lại, không phải của OCR. Vẽ bất cứ điều gì ở đây khi chưa thực hiện phép đo sẽ là bịa số liệu, nên biểu đồ được giao ở dạng khung trống, chỉnh sửa được." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1320" height="74" as="geometry"/></mxCell><mxCell id="plot" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="140" y="210" width="600" height="390" as="geometry"/></mxCell><mxCell id="nodata" value="CHƯA CÓ DỮ LIỆU&lt;br&gt;Vẽ mỗi công cụ OCR thành một đường / nhóm cột tại đây&lt;br&gt;sau khi thực hiện quy trình đo bên dưới." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="370" width="400" height="70" as="geometry"/></mxCell><mxCell id="ylab" value="Thời gian xử lý&lt;br&gt;mỗi tài liệu&lt;br&gt;(giây)&lt;br&gt;&lt;br&gt;trục dọc được chia&lt;br&gt;theo số liệu đo&lt;br&gt;thực tế" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="110" height="210" as="geometry"/></mxCell><mxCell id="xt0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt1" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt2" value="5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt3" value="10" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xt4" value="20" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="606" width="100" height="26" as="geometry"/></mxCell><mxCell id="xlab" value="Số trang" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="200" height="30" as="geometry"/></mxCell><mxCell id="leg" value="Chuỗi số liệu — mỗi công cụ OCR một chuỗi&lt;br&gt;&lt;br&gt;■  PaddleOCR Legacy      (paddleocr)&lt;br&gt;■  PaddleOCR Modern    (paddleocr_modern)&lt;br&gt;■  VietOCR                        (vietocr)&lt;br&gt;■  GLM-OCR                     (glmocr)&lt;br&gt;■  GLM Layout + VietOCR (glm_vietocr)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="780" y="210" width="300" height="190" as="geometry"/></mxCell><mxCell id="sep" value="Trình bày riêng lần chạy đầu tiên&lt;br&gt;&lt;br&gt;Yêu cầu đầu tiên với mỗi công cụ còn kèm việc nạp mô hình:&lt;br&gt;• PaddleOCR / PP-StructureV3 tải và khởi tạo&lt;br&gt;  pipeline ở lần dùng đầu&lt;br&gt;• VietOCR nạp tệp trọng số .pth&lt;br&gt;• máy chủ MLX giữ GLM-OCR thường trú, nhưng tiến&lt;br&gt;  trình con glmocr và PP-DocLayoutV3 khởi động lại&lt;br&gt;  ở mỗi lần gọi&lt;br&gt;&lt;br&gt;Gộp phép đo đầu tiên vào đường ổn định sẽ làm&lt;br&gt;sai lệch tỷ lệ của biểu đồ." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="780" y="418" width="300" height="192" as="geometry"/></mxCell><mxCell id="proc" value="Số liệu lấy từ đâu&lt;br&gt;(đã có sẵn trong mã)&lt;br&gt;&lt;br&gt;1. Mỗi bộ thích nghi tự đo thời&lt;br&gt;    gian thực và trả về&lt;br&gt;    elapsed_ms.&lt;br&gt;&lt;br&gt;2. app.py chép giá trị đó sang&lt;br&gt;    processing_time_ms trong&lt;br&gt;    phản hồi của /api/ocr/page.&lt;br&gt;&lt;br&gt;3. Với /api/ocr/all, các giá trị&lt;br&gt;    được cộng lại và ghi vào&lt;br&gt;    chuỗi detail của activity_logs&lt;br&gt;    cùng tên công cụ và số trang.&lt;br&gt;&lt;br&gt;4. /admin/logs liệt kê các bản ghi&lt;br&gt;    đó và lọc được theo&lt;br&gt;    action = &quot;ocr&quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1120" y="210" width="240" height="400" as="geometry"/></mxCell><mxCell id="rec" value="Quy trình đo cần thực hiện trước khi hoàn thiện hình này&lt;br&gt;&lt;br&gt;1.  Chọn một tập tài liệu cố định có 1, 2, 5, 10 và 20 trang, mỗi tài liệu tải lên một lần.&lt;br&gt;2.  Với mỗi công cụ, chạy làm nóng trên một tài liệu bỏ đi; ghi riêng phép đo đầu tiên đó.&lt;br&gt;3.  Gọi POST /api/ocr/all với tham số engine chỉ định rõ, lặp ba lần cho mỗi cặp (tài liệu, công cụ).&lt;br&gt;4.  Đọc processing_time_ms (hoặc giá trị tổng trong chuỗi detail của activity_logs) và lấy trung vị.&lt;br&gt;5.  Ghi kèm các điều kiện cố định: đời máy, giá trị cfg.DEVICE, cờ OFFLINE, máy chủ MLX có đang chạy sẵn&lt;br&gt;     hay không, và kích thước / độ phân giải chính xác của tài liệu.&lt;br&gt;6.  Lưu ý VietOCR chuyển sang PaddleOCR khi đầu vào là PDF, nên cột nhiều trang của VietOCR thực chất đo&lt;br&gt;     nhánh thay thế đó." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1320" height="130" as="geometry"/></mxCell><mxCell id="n1" value="Ràng buộc về tính công bằng suy ra từ mã nguồn: kết quả được lưu trong bộ nhớ theo khóa (băm tệp, số trang, trạng thái tệp, công cụ), nên lặp lại đúng trang đó với đúng công cụ trong cùng một phiên máy chủ sẽ trả về kết quả trong bộ nhớ đệm thay vì chạy lại suy luận. Hãy khởi động lại ứng dụng, hoặc dùng tài liệu khác, giữa các lần lặp." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="1320" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>