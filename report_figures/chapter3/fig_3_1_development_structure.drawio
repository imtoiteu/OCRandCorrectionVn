<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.1 – Cấu trúc môi trường phát triển và các thành phần mã nguồn của hệ thống" id="fig_3_1_development_structure"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.1 – Cấu trúc môi trường phát triển và các thành phần mã nguồn của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1340" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Bố cục thư mục và các môi trường Python của OCRandCorrectionVn (đối chiếu trực tiếp với cây thư mục làm việc)" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1340" height="20" as="geometry"/></mxCell><mxCell id="repo" value="OCRandCorrectionVn/   —   kho mã nguồn git" style="swimlane;rounded=1;arcSize=4;startSize=40;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D4E1F5;strokeColor=#3F61A8;swimlaneFillColor=#EEF3FB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="880" height="990" as="geometry"/></mxCell><mxCell id="env" value="Môi trường Python  (do người phát triển tạo)" style="swimlane;rounded=1;arcSize=4;startSize=40;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFF5EB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="950" y="92" width="430" height="470" as="geometry"/></mxCell><mxCell id="r0" value="glm-ocr-ui/     —     ứng dụng web SmartDocs (Flask, cổng 5001)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11.5;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="repo"><mxGeometry x="22" y="54" width="836" height="34" as="geometry"/></mxCell><mxCell id="r1" value="app.py · auth.py · admin_bp.py · correction_bp.py · config.py · models.py&lt;br&gt;điểm khởi động, các blueprint, đối tượng cấu hình, mô hình SQLAlchemy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="94" width="836" height="54" as="geometry"/></mxCell><mxCell id="r2" value="services/     ocr_service · smart_ocr_service · text_service · layout_service&lt;br&gt;geometry_service · markdown_normalize · activity_registry · cpu_threads" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="154" width="836" height="52" as="geometry"/></mxCell><mxCell id="r3" value="services/ocr_engines/     base · router · paddle_adapter · paddle_modern_adapter&lt;br&gt;vietocr_adapter · glm_adapter · glm_vietocr_adapter" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="212" width="836" height="52" as="geometry"/></mxCell><mxCell id="r4" value="services/vi_correction/     classification · masking · segmentation · pipeline · validation&lt;br&gt;renderers · service · providers/{protonx, bmd1905, mrlasdt, mock}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="270" width="836" height="52" as="geometry"/></mxCell><mxCell id="r5" value="static/     index.html · app.js · ocr-canvas.js · correction.html · correction.js · i18n.js&lt;br&gt;style.css · vendor/{katex, marked}   (không cần bước build frontend)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="328" width="836" height="44" as="geometry"/></mxCell><mxCell id="r6" value="templates/     login.html · 403.html · admin/{base, dashboard, users, logs, files}.html" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="378" width="836" height="38" as="geometry"/></mxCell><mxCell id="r7" value="tools/     glm_serve.sh · setup_offline.py · warmup_modern_models.py&lt;br&gt;download_chat_model.py · eval_model.py · ab_harness.py" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="422" width="836" height="44" as="geometry"/></mxCell><mxCell id="r8" value="docs/     ARCHITECTURE.md · ARCHITECTURE-DIAGRAMS.md · DEPLOYMENT.md · INSTALLATION.md&lt;br&gt;OCR_ENGINES.md · diagrams/" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="472" width="836" height="38" as="geometry"/></mxCell><mxCell id="r9" value="test_layout.py · test_regression.py · test_vietocr.py · test_refactored_ocr.py · test_markdown_normalize.py" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="516" width="836" height="38" as="geometry"/></mxCell><mxCell id="r10" value="requirements.txt · .env.example · run_mac.sh · run_windows.bat · README.md · CLAUDE.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="560" width="836" height="38" as="geometry"/></mxCell><mxCell id="r11" value="sinh ra lúc chạy (không đưa vào git):     uploads/     paddleocr.db     models/" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="604" width="836" height="40" as="geometry"/></mxCell><mxCell id="r12" value="glm-ocr-server/     —     bộ SDK GLM-OCR và máy chủ mô hình MLX" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;fontStyle=1;" vertex="1" parent="repo"><mxGeometry x="22" y="660" width="836" height="34" as="geometry"/></mxCell><mxCell id="r13" value="glmocr/     cli · api · config · server · pipeline/ (pipeline, _workers, _state, _unit_tracker)&lt;br&gt;layout/ (PP-DocLayoutV3) · dataloader/ · ocr_client · maas_client · postprocess/ · utils/ · tests/" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="700" width="836" height="52" as="geometry"/></mxCell><mxCell id="r14" value="mlx_config.yaml (chế độ self-hosted → :8080) · glmocr/config.yaml · examples/ · skills/ · ui/ · resources/" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="758" width="836" height="38" as="geometry"/></mxCell><mxCell id="r15" value="apps/backend (FastAPI) · apps/frontend (React + Vite) · Dockerfile     —     bản demo GLM-OCR gốc, SmartDocs KHÔNG sử dụng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="repo"><mxGeometry x="22" y="802" width="836" height="38" as="geometry"/></mxCell><mxCell id="r16" value="models/     protonx-legal-tc · distilled-protonx-legal-tc · nano-protonx-legal-tc · vietocr/config.yml" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;fontStyle=1;" vertex="1" parent="repo"><mxGeometry x="22" y="846" width="836" height="34" as="geometry"/></mxCell><mxCell id="r17" value="vi-correction-prototype/     bản thử nghiệm độc lập: vicorrect/ · scripts/bench_spans.py · tests/" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;" vertex="1" parent="repo"><mxGeometry x="22" y="886" width="836" height="34" as="geometry"/></mxCell><mxCell id="r18" value="README.md     ·     RUN_MACOS.md   (hướng dẫn cài đặt và chạy)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;fontStyle=1;" vertex="1" parent="repo"><mxGeometry x="22" y="926" width="836" height="34" as="geometry"/></mxCell><mxCell id="v1" value="glm-ocr-ui/.venv          Python 3.10&lt;br&gt;flask · flask-login · flask-sqlalchemy&lt;br&gt;paddleocr 3.7.x · paddlex[ocr-core] · paddlepaddle&lt;br&gt;vietocr · torch · transformers · pypdfium2&lt;br&gt;Pillow · layoutparser · python-docx · python-dotenv" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="env"><mxGeometry x="22" y="56" width="386" height="120" as="geometry"/></mxCell><mxCell id="v2" value="glm-ocr-server/.venv-sdk          Python 3.10&lt;br&gt;pip install -e &quot;.[selfhosted]&quot;&lt;br&gt;cung cấp lệnh glmocr mà GLMOCREngine gọi tới" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="env"><mxGeometry x="22" y="190" width="386" height="78" as="geometry"/></mxCell><mxCell id="v3" value="glm-ocr-server/.venv-mlx          Python 3.10&lt;br&gt;pip install -U mlx-vlm&lt;br&gt;chạy  python -m mlx_vlm.server --port 8080" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="env"><mxGeometry x="22" y="282" width="386" height="78" as="geometry"/></mxCell><mxCell id="v4" value="Cả ba môi trường đều không được đưa vào git;&lt;br&gt;tất cả được tạo theo RUN_MACOS.md (§3, §6, §7). GLM_ROOT / GLM_SDK_PYTHON / GLM_MLX_PYTHON trong .env&lt;br&gt;chỉ cho glm-ocr-ui biết vị trí hai môi trường kia." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="env"><mxGeometry x="22" y="374" width="386" height="74" as="geometry"/></mxCell><mxCell id="mdl" value="Tệp mô hình được phân giải lúc chạy&lt;br&gt;&lt;br&gt;• MODEL_DIR/huggingface  —  HF_HOME / HF_HUB_CACHE (OFFLINE=1 chặn tải về)&lt;br&gt;• bộ nhớ đệm mô hình PaddleOCR / PaddleX  —  tải về ở lần OCR đầu tiên&lt;br&gt;• MODEL_DIR/vietocr/&lt;config&gt;.pth  —  trọng số VietOCR&lt;br&gt;• bộ nhớ đệm HF mặc định  —  PP-DocLayoutV3 và mlx-community/GLM-OCR-bf16&lt;br&gt;  (tiến trình con GLM cố ý chạy không kèm các biến HF_* đã đổi hướng)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="950" y="590" width="430" height="140" as="geometry"/></mxCell><mxCell id="todo" value="CẦN HOÀN THIỆN THỦ CÔNG&lt;br&gt;&lt;br&gt;Phần thuyết minh mô tả Hình 3.1 gồm hai khối là SmartDocs-Agent-WebApp và SmartDocs-Agent-DesktopApp (Tauri/Rust, giao diện web nhúng, Python sidecar và ba chế độ kết nối backend).&lt;br&gt;&lt;br&gt;Kho mã nguồn này không có mã của ứng dụng desktop. Tìm trên toàn kho các từ khóa &quot;tauri&quot;, &quot;sidecar&quot;, &quot;Bundled Core&quot;, &quot;Remote Server&quot; và cổng 5002 đều không ra mã ứng dụng, cũng không có thư mục src-tauri/, tệp Cargo.toml hay package.json của một vỏ desktop.&lt;br&gt;&lt;br&gt;Chỉ khối WebApp ở trên là dựng được từ mã nguồn. Khối DesktopApp phải bổ sung thủ công, hoặc thu hẹp chú thích hình lại còn WebApp." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="950" y="756" width="430" height="232" as="geometry"/></mxCell><mxCell id="n1" value="Ghi chú khi đọc — README.md và docs/ trong glm-ocr-ui mô tả một sản phẩm lớn hơn (&quot;SmartDocs-Agent&quot; với trò chuyện RAG, dịch, tóm tắt, tác tử LLM, gói agent/). Các thư mục đó không có trong kho mã nguồn này; requirements.txt vẫn còn liệt kê thư viện của chúng. Hình chỉ thể hiện các tệp thực sự tồn tại trong cây thư mục làm việc." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="1096" width="1340" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>