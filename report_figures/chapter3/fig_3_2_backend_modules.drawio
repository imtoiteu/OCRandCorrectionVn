vertex="1" parent="1"><mxGeometry x="40" y="928" width="1340" height="130" as="geometry"/></mxCell><mxCell id="c1" value="SmartDocs SPA — static/index.html + app.js&lt;br&gt;fetch() JSON + multipart" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="cli"><mxGeometry x="22" y="38" width="420" height="52" as="geometry"/></mxCell><mxCell id="c2" value="Correction page — static/correction.html&lt;br&gt;+ correction.js" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="cli"><mxGeometry x="462" y="38" width="400" height="52" as="geometry"/></mxCell><mxCell id="c3" value="Server-rendered admin pages and login form&lt;br&gt;templates/admin/*.html · login.html" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="cli"><mxGeometry x="882" y="38" width="436" height="52" as="geometry"/></mxCell><mxCell id="cfg" value="config.py&lt;br&gt;cfg singleton read at import:&lt;br&gt;HOST · PORT · DB_PATH · UPLOAD_DIR&lt;br&gt;MODEL_DIR · OFFLINE · DEVICE&lt;br&gt;OCR_ENGINE · GLM_* · VI_CORRECTION_*" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="300" height="104" as="geometry"/></mxCell><mxCell id="app" value="app.py   —   Flask application object&lt;br&gt;SECRET_KEY · MAX_CONTENT_LENGTH · session-cookie flags · LoginManager + user_loader&lt;br&gt;unauthorized_handler (401 JSON / redirect) · RequestEntityTooLarge → 413 · after_request no-cache&lt;br&gt;register_blueprint(auth_bp, admin_bp, correction_bp) · vn_time Jinja filter" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="236" width="620" height="104" as="geometry"/></mxCell><mxCell id="mdl" value="models.py&lt;br&gt;db (SQLAlchemy) · User · Document&lt;br&gt;DocumentArtifact · ActivityLog&lt;br&gt;log_activity() · save_artifact() · seed_admin()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1080" y="236" width="300" height="104" as="geometry"/></mxCell><mxCell id="s1" value="smart_ocr_service.run_ocr_pipeline()&lt;br&gt;→ ocr_service.run_ocr()&lt;br&gt;&lt;br&gt;activity_registry.track(&quot;ocr&quot;)&lt;br&gt;_normalize_block() · overlay rendering" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="svc"><mxGeometry x="22" y="48" width="330" height="108" as="geometry"/></mxCell><mxCell id="s2" value="services/ocr_engines/router.py&lt;br&gt;normalize_engine_name() · get_engine()&lt;br&gt;&lt;br&gt;five OCREngine adapters&lt;br&gt;(see Figure 3.7)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="svc"><mxGeometry x="372" y="48" width="300" height="108" as="geometry"/></mxCell><mxCell id="s3" value="layout_service / geometry_service&lt;br&gt;reading-order reconstruction&lt;br&gt;&lt;br&gt;text_service.read_file()&lt;br&gt;markdown_normalize.repair_…()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="svc"><mxGeometry x="692" y="48" width="300" height="108" as="geometry"/></mxCell><mxCell id="s4" value="vi_correction.run_correction()&lt;br&gt;classification → masking → segmentation&lt;br&gt;→ provider.correct_batch()&lt;br&gt;→ restore → validation → renderers" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="svc"><mxGeometry x="1012" y="48" width="306" height="108" as="geometry"/></mxCell><mxCell id="d1" value="SQLite  paddleocr.db&lt;br&gt;users · documents&lt;br&gt;document_artifacts · activity_logs" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="22" y="44" width="320" height="66" as="geometry"/></mxCell><mxCell id="d2" value="uploads/&lt;br&gt;{uuid4}{suffix}&lt;br&gt;+ transient page .png files" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="362" y="44" width="300" height="66" as="geometry"/></mxCell><mxCell id="d3" value="models/  ·  HF cache&lt;br&gt;PaddleX cache  ·  VietOCR weights" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="682" y="44" width="300" height="66" as="geometry"/></mxCell><mxCell id="d4" value="External processes&lt;br&gt;glmocr CLI (.venv-sdk)  ·  MLX :8080&lt;br&gt;pandoc" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="1002" y="44" width="316" height="66" as="geometry"/></mxCell><mxCell id="n1" value="Call-flow rule visible in the code: the browser never reaches a model or the database directly. Every request enters Flask, is checked by @login_required (and @admin_required for /admin), is resolved to an owned Document, and only then reaches the service layer; persistence happens exclusively through models.py. The OCR routes never import an OCR library themselves — they call smart_ocr_service → ocr_service → router → adapter." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry