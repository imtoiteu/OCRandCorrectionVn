<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.8 – Kết quả OCR dạng văn bản và dữ liệu có cấu trúc" id="fig_3_8_ocr_result_representations"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.8 – Kết quả OCR dạng văn bản và dữ liệu có cấu trúc" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1360" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Data flow behind the result view — which engine produces which representation, how it is persisted and how it is delivered" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1360" height="20" as="geometry"/></mxCell><mxCell id="view" value="Delivery to the browser   (static/app.js — OCRView)" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F0F6FD;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="700" height="300" as="geometry"/></mxCell><mxCell id="exp" value="Export and downstream use" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#EFF6EE;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="620" height="300" as="geometry"/></mxCell><mxCell id="res" value="Engine result dict&lt;br&gt;(one per page)&lt;br&gt;&lt;br&gt;results[] · img_width / img_height&lt;br&gt;elapsed_ms · ocr_engine&lt;br&gt;inference_status · layout_native&lt;br&gt;markdow