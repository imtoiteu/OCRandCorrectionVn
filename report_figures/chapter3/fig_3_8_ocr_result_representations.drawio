ab&lt;br&gt;plain text joined from results[]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="22" y="118" width="320" height="56" as="geometry"/></mxCell><mxCell id="v3" value="Images tab&lt;br&gt;layout overlays and cropped regions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="22" y="186" width="320" height="56" as="geometry"/></mxCell><mxCell id="v4" value="JSON tab&lt;br&gt;structured per-page regions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="362" y="50" width="316" height="56" as="geometry"/></mxCell><mxCell id="v5" value="Canvas overlay (ocr-canvas.js)&lt;br&gt;boxes drawn over the page image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="362" y="118" width="316" height="56" as="geometry"/></mxCell><mxCell id="v6" value="Statistics strip&lt;br&gt;regions · mean confidence · time · pages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="362" y="186" width="316" height="56" as="geometry"/></mxCell><mxCell id="x1" value="Download .md&lt;br&gt;(real Markdown when available)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="22" y="50" width="280" height="56" as="geometry"/></mxCell><mxCell id="x2" value="Download .txt&lt;br&gt;plain OCR text" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="22" y="118" width="280" height="56" as="geometry"/></mxCell><mxCell id="x3" value="Download .json&lt;br&gt;structured output, all pages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="22" y="186" width="280" height="56" as="geometry"/></mxCell><mxCell id="x4" value="POST /api/ocr/export-docx&lt;br&gt;pandoc  markdown+smart+tex_math_dollars&lt;br&gt;→ .docx  (timeout 30 s)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="322" y="50" width="278" height="90" as="geometry"/></mxCell><mxCell id="x5" value="Vietnamese correction&lt;br&gt;consumes the ocr_json artifact →&lt;br&gt;corrected_json / corrected_md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="322" y="158" width="278" height="84" as="geometry"/></mxCell><mxCell id="cap" value="Engine capability matrix (from the adapters)&lt;br&gt;&lt;br&gt;PaddleOCR Legacy   →  results + confidence + boxes;  ocr_json holds results + layout_blocks;  generated overlay image&lt;br&gt;VietOCR                    →  results + boxes (confidence = None);  ocr_json fallback shape;  generated overlay image&lt;br&gt;PaddleOCR Modern  →  results + confidence + boxes  +  markdown, html, tables_html, layout_blocks, labelled overlay&lt;br&gt;GLM-OCR                  →  results + boxes (confidence = None)  +  markdown, tables_html, layout_blocks, raw_json,&lt;br&gt;                                      layout_vis images and cropped region images&lt;br&gt;GLM + VietOCR        →  GLM structure with VietOCR text, plus per-block recognition_source and fallback_reason" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" 