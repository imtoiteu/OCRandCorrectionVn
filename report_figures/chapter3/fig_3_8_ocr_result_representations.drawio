<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.8 – Kết quả OCR theo văn bản và dữ liệu có cấu trúc" id="fig_3_8_ocr_result_representations"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.8 – Kết quả OCR theo văn bản và dữ liệu có cấu trúc" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1360" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Luồng dữ liệu phía sau màn hình kết quả — công cụ nào sinh ra dạng biểu diễn nào, được lưu ra sao và trả về bằng cách nào" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1360" height="20" as="geometry"/></mxCell><mxCell id="view" value="Hiển thị trên trình duyệt   (static/app.js — OCRView)" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F0F6FD;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="700" height="300" as="geometry"/></mxCell><mxCell id="exp" value="Kết xuất và sử dụng tiếp" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#EFF6EE;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="620" height="300" as="geometry"/></mxCell><mxCell id="res" value="Từ điển kết quả của công cụ&lt;br&gt;(một từ điển cho mỗi trang)&lt;br&gt;&lt;br&gt;results[] · img_width / img_height&lt;br&gt;elapsed_ms · ocr_engine&lt;br&gt;inference_status · layout_native&lt;br&gt;markdown? · html? · tables_html?&lt;br&gt;layout_blocks? · images? · raw_json?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="168" as="geometry"/></mxCell><mxCell id="p1" value="_ocr_pages_to_text()&lt;br&gt;nối văn bản mọi khối trên mọi trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="300" height="76" as="geometry"/></mxCell><mxCell id="p2" value="_build_ocr_layout()&lt;br&gt;khung bao · độ tin cậy · kích thước · thời gian" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="300" height="76" as="geometry"/></mxCell><mxCell id="p3" value="_persist_ocr_structured()&lt;br&gt;markdown → markdown_normalize&lt;br&gt;.repair_unmatched_display_math()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="300" height="100" as="geometry"/></mxCell><mxCell id="db" value="SQLite&lt;br&gt;document_artifacts&lt;br&gt;&lt;br&gt;UNIQUE&lt;br&gt;(document_id, kind)&lt;br&gt;&lt;br&gt;ghi đè bằng&lt;br&gt;save_artifact()" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1240" y="96" width="160" height="226" as="geometry"/></mxCell><mxCell id="v1" value="Thẻ Markdown&lt;br&gt;marked + KaTeX nội bộ + sanitizeHtml()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="22" y="50" width="320" height="56" as="geometry"/></mxCell><mxCell id="v2" value="Thẻ Raw&lt;br&gt;văn bản thuần nối từ results[]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="22" y="118" width="320" height="56" as="geometry"/></mxCell><mxCell id="v3" value="Thẻ Images&lt;br&gt;ảnh phủ bố cục và ảnh cắt từng vùng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="22" y="186" width="320" height="56" as="geometry"/></mxCell><mxCell id="v4" value="Thẻ JSON&lt;br&gt;vùng nhận dạng theo từng trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="362" y="50" width="316" height="56" as="geometry"/></mxCell><mxCell id="v5" value="Lớp phủ canvas (ocr-canvas.js)&lt;br&gt;khung bao vẽ trên ảnh trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="362" y="118" width="316" height="56" as="geometry"/></mxCell><mxCell id="v6" value="Dải thống kê&lt;br&gt;số vùng · độ tin cậy TB · thời gian · số trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="view"><mxGeometry x="362" y="186" width="316" height="56" as="geometry"/></mxCell><mxCell id="x1" value="Tải về .md&lt;br&gt;(Markdown thật khi có)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="22" y="50" width="280" height="56" as="geometry"/></mxCell><mxCell id="x2" value="Tải về .txt&lt;br&gt;văn bản OCR thuần" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="22" y="118" width="280" height="56" as="geometry"/></mxCell><mxCell id="x3" value="Tải về .json&lt;br&gt;dữ liệu có cấu trúc, mọi trang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="22" y="186" width="280" height="56" as="geometry"/></mxCell><mxCell id="x4" value="POST /api/ocr/export-docx&lt;br&gt;pandoc  markdown+smart+tex_math_dollars&lt;br&gt;→ .docx  (timeout 30 giây)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="322" y="50" width="278" height="90" as="geometry"/></mxCell><mxCell id="x5" value="Hiệu chỉnh tiếng Việt&lt;br&gt;đọc kết xuất ocr_json →&lt;br&gt;corrected_json / corrected_md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="exp"><mxGeometry x="322" y="158" width="278" height="84" as="geometry"/></mxCell><mxCell id="cap" value="Bảng năng lực của từng công cụ (rút ra từ các bộ thích nghi)&lt;br&gt;&lt;br&gt;PaddleOCR Legacy   →  kết quả + độ tin cậy + khung bao;  ocr_json chứa results + layout_blocks;  ảnh phủ tự sinh&lt;br&gt;VietOCR                    →  kết quả + khung bao (độ tin cậy = None);  ocr_json dạng dự phòng;  ảnh phủ tự sinh&lt;br&gt;PaddleOCR Modern  →  kết quả + độ tin cậy + khung bao  +  markdown, html, tables_html, layout_blocks, ảnh phủ có nhãn&lt;br&gt;GLM-OCR                  →  kết quả + khung bao (độ tin cậy = None)  +  markdown, tables_html, layout_blocks, raw_json,&lt;br&gt;                                      ảnh layout_vis và ảnh cắt từng vùng&lt;br&gt;GLM + VietOCR        →  bố cục của GLM với văn bản của VietOCR, kèm recognition_source và fallback_reason theo khối" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="1360" height="128" as="geometry"/></mxCell><mxCell id="todo" value="MỘT PHẦN — phần thuyết minh trình bày Hình 3.8 dưới dạng ảnh chụp màn hình kết quả. Hình ở trên là kiến trúc và luồng dữ liệu phía sau màn hình đó, tức là phần mà mã nguồn hỗ trợ. Nếu báo cáo cần chính màn hình, hãy chụp khu vực làm việc OCR của một tài liệu với các thẻ Markdown, Raw, Images và JSON hiển thị cạnh ảnh trang (xem MANUAL_COMPLETION.md, Hình 3.8)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1360" height="96" as="geometry"/></mxCell><mxCell id="art" value="Các kết xuất document_artifacts do app.py ghi" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#EDEDED;strokeColor=#5A5A5A;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="380" height="202" as="geometry"/></mxCell><mxCell id="art_r0" value="ocr                 văn bản thuần  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="28" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r1" value="ocr_layout      JSON khung bao / độ tin cậy  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="49" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r2" value="ocr_images    JSON ảnh phủ + ảnh cắt (base64)  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="70" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r3" value="ocr_json         JSON vùng theo từng trang  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="91" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r4" value="ocr_markdown  Markdown  &lt;b&gt;GLM · Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="112" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r5" value="ocr_html         HTML  &lt;b&gt;Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="133" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r6" value="ocr_tables      JSON danh sách bảng HTML  &lt;b&gt;GLM · Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="154" width="380" height="21" as="geometry"/></mxCell><mxCell id="art_r7" value="ocr_blocks     JSON nhãn / nội dung / bbox / thứ tự  &lt;b&gt;GLM · Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="art"><mxGeometry x="0" y="175" width="380" height="21" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCel