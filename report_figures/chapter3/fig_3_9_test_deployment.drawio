<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.9 – Mô hình triển khai hệ thống trong môi trường thử nghiệm" id="fig_3_9_test_deployment"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.9 – Mô hình triển khai hệ thống trong môi trường thử nghiệm" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Mô hình triển khai thử nghiệm đúng như tài liệu RUN_MACOS.md mô tả và config.py / tools/glm_serve.sh hiện thực hóa" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="mach" value="Máy thử nghiệm  —  macOS Apple Silicon (M1 / M2 / M3 / M4) · Python 3.10 · Homebrew" style="swimlane;rounded=1;arcSize=4;startSize=38;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFF5EB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1000" height="646" as="geometry"/></mxCell><mxCell id="t1" value="Cửa sổ lệnh 1   —   máy chủ mô hình GLM-OCR MLX&lt;br&gt;&lt;br&gt;GLM_ROOT=&quot;$PWD/glm-ocr-server&quot;&lt;br&gt;GLM_MLX_PYTHON=&quot;$PWD/glm-ocr-server/.venv-mlx/bin/python&quot;&lt;br&gt;bash glm-ocr-ui/tools/glm_serve.sh&lt;br&gt;&lt;br&gt;exec python -m mlx_vlm.server --trust-remote-code --port 8080&lt;br&gt;mô hình nằm thường trú giữa các yêu cầu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="58" width="470" height="152" as="geometry"/></mxCell><mxCell id="t2" value="Cửa sổ lệnh 2   —   ứng dụng web SmartDocs&lt;br&gt;&lt;br&gt;cd glm-ocr-ui  ·  source .venv/bin/activate&lt;br&gt;python app.py&lt;br&gt;&lt;br&gt;máy chủ phát triển đa luồng của Flask&lt;br&gt;http://localhost:5001   (HOST 0.0.0.0, PORT 5001)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="512" y="58" width="466" height="152" as="geometry"/></mxCell><mxCell id="sdk" value="GLM-OCR SDK  —  glm-ocr-server/.venv-sdk&lt;br&gt;được glm_adapter.py khởi chạy cho mỗi yêu cầu OCR:&lt;br&gt;python -m glmocr.cli parse &lt;page.png&gt; --config mlx_config.yaml --mode selfhosted&lt;br&gt;PP-DocLayoutV3 chạy trên CPU (mlx_config.yaml: layout.device = cpu)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="236" width="470" height="96" as="geometry"/></mxCell><mxCell id="eng" value="Công cụ OCR chạy trong tiến trình Flask&lt;br&gt;PaddleOCR PP-OCRv5 · PP-StructureV3 + PP-OCRv6_medium&lt;br&gt;VietOCR vgg_transformer&lt;br&gt;cfg.DEVICE tự phân giải: CUDA → MPS → CPU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="512" y="236" width="466" height="96" as="geometry"/></mxCell><mxCell id="db" value="SQLite  paddleocr.db&lt;br&gt;tạo bởi db.create_all()&lt;br&gt;tài khoản khởi tạo sẵn:&lt;br&gt;admin / admin123 · user / user123" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="358" width="300" height="88" as="geometry"/></mxCell><mxCell id="up" value="uploads/&lt;br&gt;tệp gốc, đặt tên theo UUID&lt;br&gt;+ tệp .png tạm của từng trang&lt;br&gt;MAX_UPLOAD_MB = 50" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="344" y="358" width="300" height="88" as="geometry"/></mxCell><mxCell id="mm" value="models/ · bộ nhớ đệm HF · PaddleX&lt;br&gt;OFFLINE=0 ở lần chạy đầu để tải mô hình,&lt;br&gt;sau đó OFFLINE=1 để chạy ngoại tuyến" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="664" y="358" width="314" height="88" as="geometry"/></mxCell><mxCell id="env" value="Các khóa .env xác định môi trường này  (glm-ocr-ui/.env, theo .env.example và RUN_MACOS.md)&lt;br&gt;&lt;br&gt;HOST=0.0.0.0   PORT=5001   OFFLINE=0/1   DEVICE=auto   MODEL_DIR=./models   OCR_ENGINE=paddle&lt;br&gt;GLM_ROOT=&lt;repo&gt;/glm-ocr-server        GLM_SDK_PYTHON=&lt;repo&gt;/glm-ocr-server/.venv-sdk/bin/python&lt;br&gt;GLM_MLX_PYTHON=&lt;repo&gt;/glm-ocr-server/.venv-mlx/bin/python     GLM_CONFIG_YAML=&lt;repo&gt;/glm-ocr-server/mlx_config.yaml&lt;br&gt;GLM_OCR_API_URL=http://localhost:8080   GLM_TIMEOUT=300&lt;br&gt;VI_CORRECTION_ENABLED=true   VI_CORRECTION_PROVIDER=protonx   VI_CORRECTION_MODEL=nano   VI_CORRECTION_DEVICE=cpu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="470" width="954" height="152" as="geometry"/></mxCell><mxCell id="cliB" value="Người kiểm thử&lt;br&gt;trình duyệt trên cùng máy&lt;br&gt;(http://localhost:5001)&lt;br&gt;hoặc trên một máy khác cùng&lt;br&gt;mạng nội bộ (HOST = 0.0.0.0)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="280" height="130" as="geometry"/></mxCell><mxCell id="todo" value="CẦN HOÀN THIỆN THỦ CÔNG&lt;br&gt;&lt;br&gt;Phần thuyết minh yêu cầu Hình 3.9 thể hiện WebApp ở cổng 5002 và một DesktopApp với ba chế độ Bundled Core, Existing WebApp Runtime và Remote Server.&lt;br&gt;&lt;br&gt;Kho mã nguồn này không có cả hai: cổng ứng dụng là 5001 (mặc định trong config.py và trong RUN_MACOS.md), không có ứng dụng desktop, không có phần chọn chế độ chạy và không có mã kết nối tới máy chủ từ xa.&lt;br&gt;&lt;br&gt;Cổng 5002 chỉ xuất hiện trong glm-ocr-server/glmocr/config.yaml và mlx_config.yaml, là cổng mặc định của dịch vụ HTTP tùy chọn glmocr.server mà SmartDocs không dùng — SmartDocs gọi trực tiếp qua dòng lệnh." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1080" y="310" width="300" height="300" as="geometry"/></mxCell><mxCell id="n1" value="Nguyên tắc truy cập thể hiện trong mô hình triển khai: trình duyệt chỉ làm việc với Flask ở cổng 5001. Máy chủ mô hình MLX ở cổng 8080 chỉ được tiến trình con glmocr tạm thời gọi tới, còn cơ sở dữ liệu và thư mục uploads chỉ được app.py / models.py truy cập, nhờ đó phân quyền, trạng thái tài liệu và nhật ký hoạt động luôn nhất quán bất kể người dùng truy cập bằng cách nào." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1320" height="62" as="geometry"/></mxCell><mxCell id="n2" value="Không thuộc môi trường thử nghiệm: không có container runtime, không có proxy ngược, không có máy chủ WSGI cho môi trường thật, không có cơ sở dữ liệu ngoài và không có dịch vụ OCR đám mây. Nhánh đám mây (MaaS) của SDK bị tắt bởi mlx_config.yaml (pipeline.maas.enabled = false) và bộ thích nghi luôn truyền tham số --mode selfhosted." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="1320" height="62" as="geometry"/></mxCell><mxCell id="e0" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cliB" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="tiến trình con" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="sdk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="226"/><mxPoint x="540" y="310"/><mxPoint x="299" y="310"/></Array></mxGeometry></mxCell><mxCell id="e2" value="HTTP  localhost:8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdk" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="trong tiến trình" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="SQLAlchemy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="436"/><mxPoint x="214" y="436"/></Array></mxGeometry></mxCell><mxCell id="e5" value="thao tác tệp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="up"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="436"/><mxPoint x="534" y="436"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>