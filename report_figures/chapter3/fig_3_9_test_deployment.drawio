<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.9 – Mô hình triển khai hệ thống trong môi trường thử nghiệm" id="fig_3_9_test_deployment"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.9 – Mô hình triển khai hệ thống trong môi trường thử nghiệm" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Test-environment deployment exactly as documented in RUN_MACOS.md and implemented in config.py / tools/glm_serve.sh" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="mach" value="Test machine  —  macOS Apple Silicon (M1 / M2 / M3 / M4) · Python 3.10 · Homebrew" style="swimlane;rounded=1;arcSize=4;startSize=38;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFF5EB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1000" height="646" as="geometry"/></mxCell><mxCell id="t1" value="Terminal 1   —   GLM-OCR MLX model server&lt;br&gt;&lt;br&gt;GLM_ROOT=&quot;$PWD/glm-ocr-server&quot;&lt;br&gt;GLM_MLX_PYTHON=&quot;$PWD/glm-ocr-server/.venv-mlx/bin/python&quot;&lt;br&gt;bash glm-ocr-ui/tools/glm_serve.sh&lt;br&gt;&lt;br&gt;exec python -m mlx_vlm.server --trust-remote-code --port 8080&lt;br&gt;model held resident between requests" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="58" width="470" height="152" as="geometry"/></mxCell><mxCell id="t2" value="Terminal 2   —   SmartDocs web application&lt;br&gt;&lt;br&gt;cd glm-ocr-ui  ·  source .venv/bin/activate&lt;br&gt;python app.py&lt;br&gt;&lt;br&gt;Flask threaded development server&lt;br&gt;http://localhost:5001   (HOST 0.0.0.0, PORT 5001)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="512" y="58" width="466" height="152" as="geometry"/></mxCell><mxCell id="sdk" value="GLM-OCR SDK  —  glm-ocr-server/.venv-sdk&lt;br&gt;started per OCR request by glm_adapter.py:&lt;br&gt;python -m glmocr.cli parse &lt;page.png&gt; --config mlx_config.yaml --mode selfhosted&lt;br&gt;PP-DocLayoutV3 runs on the CPU (mlx_config.yaml: layout.device = cpu)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="236" width="470" height="96" as="geometry"/></mxCell><mxCell id="eng" value="In-process OCR engines (inside the Flask interpreter)&lt;br&gt;PaddleOCR PP-OCRv5 · PP-StructureV3 + PP-OCRv6_medium&lt;br&gt;VietOCR vgg_transformer&lt;br&gt;cfg.DEVICE resolved automatically: CUDA → MPS → CPU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="512" y="236" width="466" height="96" as="geometry"/></mxCell><mxCell id="db" value="SQLite  paddleocr.db&lt;br&gt;created by db.create_all()&lt;br&gt;seeded accounts:&lt;br&gt;admin / admin123 · user / user123" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="358" width="300" height="88" as="geometry"/></mxCell><mxCell id="up" value="uploads/&lt;br&gt;original files, UUID-named&lt;br&gt;+ transient page .png files&lt;br&gt;MAX_UPLOAD_MB = 50" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="344" y="358" width="300" height="88" as="geometry"/></mxCell><mxCell id="mm" value="models/  ·  HF cache  ·  PaddleX cache&lt;br&gt;OFFLINE=0 on the first run to fetch models,&lt;br&gt;then OFFLINE=1 for offline operation" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="664" y="358" width="314" height="88" as="geometry"/></mxCell><mxCell id="env" value=".env keys that define this environment  (glm-ocr-ui/.env, from .env.example and RUN_MACOS.md)&lt;br&gt;&lt;br&gt;HOST=0.0.0.0   PORT=5001   OFFLINE=0/1   DEVICE=auto   MODEL_DIR=./models   OCR_ENGINE=paddle&lt;br&gt;GLM_ROOT=&lt;repo&gt;/glm-ocr-server        GLM_SDK_PYTHON=&lt;repo&gt;/glm-ocr-server/.venv-sdk/bin/python&lt;br&gt;GLM_MLX_PYTHON=&lt;repo&gt;/glm-ocr-server/.venv-mlx/bin/python     GLM_CONFIG_YAML=&lt;repo&gt;/glm-ocr-server/mlx_config.yaml&lt;br&gt;GLM_OCR_API_URL=http://localhost:8080   GLM_TIMEOUT=300&lt;br&gt;VI_CORRECTION_ENABLED=true   VI_CORRECTION_PROVIDER=protonx   VI_CORRECTION_MODEL=nano   VI_CORRECTION_DEVICE=cpu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="mach"><mxGeometry x="24" y="470" width="954" height="152" as="geometry"/></mxCell><mxCell id="cliB" value="Tester&lt;br&gt;web browser on the same machine&lt;br&gt;(http://localhost:5001)&lt;br&gt;or on another machine in the same&lt;br&gt;network (HOST = 0.0.0.0)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="280" height="130" as="geometry"/></mxCell><mxCell id="todo" value="MANUAL COMPLETION REQUIRED&lt;br&gt;&lt;br&gt;The report asks Figure 3.9 to show the WebApp on port 5002 and a DesktopApp with the three backend modes Bundled Core, Existing WebApp Runtime and Remote Server.&lt;br&gt;&lt;br&gt;Neither exists in this repository: the application port is 5001 (config.py default and RUN_MACOS.md), and there is no desktop application, no runtime-mode selector and no remote-server client code.&lt;br&gt;&lt;br&gt;Port 5002 appears only in glm-ocr-server/glmocr/config.yaml and mlx_config.yaml as the default port of the optional glmocr.server HTTP wrapper, which SmartDocs does not use — it calls the CLI instead." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1080" y="310" width="300" height="300" as="geometry"/></mxCell><mxCell id="n1" value="Access rule visible in the deployment: the browser talks only to Flask on :5001. The MLX model server on :8080 is reached exclusively by the transient glmocr subprocess, and the database and the uploads directory are reached exclusively by app.py / models.py, so authorisation, document status and the activity log stay consistent regardless of the client." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1320" height="62" as="geometry"/></mxCell><mxCell id="n2" value="Not part of the test environment: no container runtime, no reverse proxy, no production WSGI server, no external database and no cloud OCR service. The GLM cloud (MaaS) path of the SDK is disabled by mlx_config.yaml (pipeline.maas.enabled = false) and the adapter always passes --mode selfhosted." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="1320" height="62" as="geometry"/></mxCell><mxCell id="e0" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cliB" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="subprocess" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="sdk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="226"/><mxPoint x="540" y="310"/><mxPoint x="299" y="310"/></Array></mxGeometry></mxCell><mxCell id="e2" value="HTTP  localhost:8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdk" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="in-process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="SQLAlchemy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="436"/><mxPoint x="214" y="436"/></Array></mxGeometry></mxCell><mxCell id="e5" value="file I/O" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="up"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="436"/><mxPoint x="534" y="436"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>