<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.6 – Quy trình tiếp nhận và chuẩn hóa tài liệu đã được hiện thực hóa" id="fig_3_6_intake_normalization"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.6 – Quy trình tiếp nhận và chuẩn hóa tài liệu đã được hiện thực hóa" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Đường tiếp nhận thực tế — app.py::upload(), _resolve_owned_file(), ocr_page() / ocr_all(), ocr_service.py, text_service.py" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1320" height="20" as="geometry"/></mxCell><mxCell id="p1" value="Giai đoạn A — tải lên    POST /api/upload" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D4E1F5;strokeColor=#3F61A8;swimlaneFillColor=#EEF3FB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="660" height="640" as="geometry"/></mxCell><mxCell id="p2" value="Giai đoạn B — chuẩn hóa trước khi OCR    POST /api/ocr/page  ·  /api/ocr/all" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#B0E3E6;strokeColor=#0E8088;swimlaneFillColor=#E0F4F5;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="92" width="640" height="640" as="geometry"/></mxCell><mxCell id="p3" value="Đường tiếp nhận thay thế cho tài liệu văn bản    POST /api/read-text" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#EFF6EE;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="764" width="1340" height="190" as="geometry"/></mxCell><mxCell id="a1" value="Người dùng chọn hoặc kéo thả tệp trên SPA&lt;br&gt;(accept = .jpg .jpeg .png .webp .pdf .txt .docx)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="46" width="616" height="44" as="geometry"/></mxCell><mxCell id="a2" value="Flask từ chối nếu kích thước vượt&lt;br&gt;MAX_CONTENT_LENGTH → 413 JSON" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="106" width="616" height="40" as="geometry"/></mxCell><mxCell id="a3" value="@login_required  ·  request.files.get(&quot;file&quot;)&lt;br&gt;thiếu tệp → 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="162" width="616" height="40" as="geometry"/></mxCell><mxCell id="a4" value="_safe_basename(): bỏ thành phần thư mục, loại ký tự&lt;br&gt;điều khiển, giữ Unicode, giới hạn 255 ký tự" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="218" width="616" height="44" as="geometry"/></mxCell><mxCell id="a5" value="suffix = Path(name).suffix.lower()&lt;br&gt;suffix ∈ ALL_EXTS ?   nếu không → 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="278" width="616" height="40" as="geometry"/></mxCell><mxCell id="a6" value="fid = uuid4()   ·   tệp được lưu thành&lt;br&gt;UPLOAD_DIR/{fid}{suffix}  (tên không lấy từ người dùng)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="334" width="616" height="44" as="geometry"/></mxCell><mxCell id="a7" value="page_count = pdf_page_count() với PDF, còn lại = 1&lt;br&gt;file_size = path.stat().st_size" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="394" width="616" height="44" as="geometry"/></mxCell><mxCell id="a8" value="INSERT Document(user_id, filename, file_id, file_type,&lt;br&gt;file_size, page_count, status=&quot;uploaded&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="454" width="616" height="44" as="geometry"/></mxCell><mxCell id="a9" value="log_activity(&quot;upload&quot;, &quot;&lt;tên tệp&gt; (&lt;suffix&gt;, &lt;dung lượng&gt;B)&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="514" width="616" height="36" as="geometry"/></mxCell><mxCell id="a10" value="200 {file_id, filename, size, suffix, doc_id,&lt;br&gt;is_pdf, is_image, page_count}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p1"><mxGeometry x="22" y="562" width="616" height="44" as="geometry"/></mxCell><mxCell id="b1" value="_resolve_owned_file(file_id)&lt;br&gt;tra cứu Document → 404 · quyền sở hữu → 403" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="46" width="596" height="44" as="geometry"/></mxCell><mxCell id="b2" value="dò UPLOAD_DIR/{uuid đã lưu}.*&lt;br&gt;không bao giờ dò bằng file_id thô → chống vượt thư mục" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="106" width="596" height="44" as="geometry"/></mxCell><mxCell id="b3" value="riêng /api/ocr/all: từ chối mọi thứ không phải&lt;br&gt;ảnh hoặc PDF → 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="166" width="596" height="40" as="geometry"/></mxCell><mxCell id="b4" value="suffix == &quot;.pdf&quot; ?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="222" width="596" height="40" as="geometry"/></mxCell><mxCell id="b5" value="PDF: pypdfium2 kết xuất trang N ở scale = 2.0&lt;br&gt;→ ảnh PIL → NamedTemporaryFile(&quot;.png&quot;) trong&lt;br&gt;UPLOAD_DIR (xóa trong khối finally)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="278" width="596" height="56" as="geometry"/></mxCell><mxCell id="b6" value="Ảnh: PIL.Image.open(path) trực tiếp&lt;br&gt;(không đổi kích thước, không nhị phân hóa, không nắn nghiêng)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="350" width="596" height="48" as="geometry"/></mxCell><mxCell id="b7" value="preview_only = true → trả page_image_b64 +&lt;br&gt;img_width / img_height, results = [] (không OCR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="414" width="596" height="44" as="geometry"/></mxCell><mxCell id="b8" value="_resolve_selected_engine(): tham số engine →&lt;br&gt;bí danh → cfg.OCR_ENGINE; vietocr + .pdf → paddleocr" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="474" width="596" height="44" as="geometry"/></mxCell><mxCell id="b9" value="smart_ocr_service.run_ocr_pipeline(image_path,&lt;br&gt;engine_name)  →  bộ định tuyến OCR (Hình 3.7)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="534" width="596" height="40" as="geometry"/></mxCell><mxCell id="b10" value="page_image_b64 được gắn vào phản hồi để vẽ lớp phủ trên canvas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="p2"><mxGeometry x="22" y="586" width="596" height="36" as="geometry"/></mxCell><mxCell id="t1" value="text_service.read_file(path)&lt;br&gt;phân nhánh theo phần mở rộng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="p3"><mxGeometry x="22" y="48" width="400" height="56" as="geometry"/></mxCell><mxCell id="t2" value=".txt&lt;br&gt;open(errors=&quot;replace&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="p3"><mxGeometry x="460" y="42" width="250" height="62" as="geometry"/></mxCell><mxCell id="t3" value=".docx&lt;br&gt;đoạn văn qua python-docx" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="p3"><mxGeometry x="460" y="114" width="250" height="62" as="geometry"/></mxCell><mxCell id="t4" value=".pdf&lt;br&gt;lớp văn bản pypdfium2&lt;br&gt;(văn bản nhúng, không OCR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="p3"><mxGeometry x="750" y="78" width="250" height="62" as="geometry"/></mxCell><mxCell id="t5" value="_persist_and_index(file_id, &quot;text&quot;, text)&lt;br&gt;→ save_artifact(kind = &quot;text&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="p3"><mxGeometry x="1038" y="78" width="280" height="62" as="geometry"/></mxCell><mxCell id="err" value="Các nhánh lỗi đã hiện thực hóa&lt;br&gt;• tệp quá lớn → 413 {&quot;error&quot;: &quot;File too large (max N MB)&quot;}&lt;br&gt;• không có tệp / phần mở rộng không hỗ trợ → 400&lt;br&gt;• file_id không tồn tại → 404;  tài liệu của người khác → 403 (quản trị viên là ngoại lệ)&lt;br&gt;• có bản ghi nhưng thiếu tệp trên đĩa → 404 &quot;File missing from disk&quot;&lt;br&gt;• mọi ngoại lệ bên trong lời gọi OCR → 500 và vết lỗi được ghi vào nhật ký" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="660" height="108" as="geometry"/></mxCell><mxCell id="lim" value="Phạm vi của &quot;chuẩn hóa&quot; trong phiên bản này&lt;br&gt;Ứng dụng chỉ chuẩn bị ảnh ở mức kết xuất trang (pypdfium2, scale = 2.0) và chuyển đổi định dạng sang PNG/JPEG. Phân loại hướng tài liệu và nắn phẳng UVDoc chỉ xảy ra bên trong pipeline PaddleOCR Modern (PPStructureV3(use_doc_orientation_classify=True, use_doc_unwarping=True)). Mã ứng dụng không có bước nắn nghiêng, khử nhiễu, nhị phân hóa hay chuẩn hóa DPI." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="984" width="640" height="108" as="geometry"/></mxCell><mxCell id="n1" value="Bộ nhớ đệm kết quả: _run_page_ocr() lưu kết quả mỗi trang vào một từ điển trong bộ nhớ, khóa theo (sha-256 của tệp, số trang, kích thước + thời điểm sửa, tên công cụ), nên chạy lại đúng trang đó với cùng công cụ sẽ không lặp lại quá trình suy luận." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="1108" width="1340" height="34" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1"