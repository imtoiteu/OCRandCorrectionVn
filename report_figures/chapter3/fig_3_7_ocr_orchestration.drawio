<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.7 – Cơ chế tích hợp và điều phối các công cụ OCR" id="fig_3_7_ocr_orchestration"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.7 – Cơ chế tích hợp và điều phối các công cụ OCR" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1360" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="services/ocr_engines/ — one abstract interface, five adapters, one common result contract" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1360" height="20" as="geometry"/></mxCell><mxCell id="req" value="Request from the OCR service&lt;br&gt;&lt;br&gt;smart_ocr_service.run_ocr_pipeline(&lt;br&gt;     image_path,&lt;br&gt;     engine_name)&lt;br&gt;&lt;br&gt;→ ocr_service.run_ocr()&lt;br&gt;     activity_registry.track(&quot;ocr&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="150" as="geometry"/></mxCell><mxCell id="router" value="OCR ROUTER   services/ocr_engines/router.py&lt;br&gt;&lt;br&gt;_ENGINES = {paddleocr, vietocr, paddleocr_modern, glmocr, glm_vietocr}&lt;br&gt;_ALIASES  (paddle, auto, modern, ppstructure, glm, glm_ocr, glm_layout_vietocr)&lt;br&gt;normalize_engine_name() → get_engine() → engine.run(image_path)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="128" width="560" height="114" as="geometry"/></mxCell><mxCell id="abc" value="Abstract interface&lt;br&gt;services/ocr_engines/base.py&lt;br&gt;&lt;br&gt;class OCREngine(ABC):&lt;br&gt;     engine_name: str&lt;br&gt;     def run(self, image_path) -&gt; dict" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="128" width="340" height="114" as="geometry"/></mxCell><mxCell id="ad1" value="PaddleOCR Legacy adapter&lt;br&gt;paddle_adapter.py · engine_name = &quot;paddleocr&quot;&lt;br&gt;&lt;br&gt;lazy PaddleOCR(ocr_version=&quot;PP-OCRv5&quot;,&lt;br&gt; use_doc_orientation_classify=False,&lt;br&gt; use_doc_unwarping=False)&lt;br&gt;in-process · returns rec_texts / rec_scores / det_polys" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad2" value="PaddleOCR Modern adapter&lt;br&gt;paddle_modern_adapter.py · &quot;paddleocr_modern&quot;&lt;br&gt;&lt;br&gt;lazy PPStructureV3(use_doc_orientation_classify=True,&lt;br&gt; use_doc_unwarping=True,&lt;br&gt; text_detection_model_name=&quot;PP-OCRv6_medium_det&quot;,&lt;br&gt; text_recognition_model_name=&quot;PP-OCRv6_medium_rec&quot;)&lt;br&gt;adds markdown · html · tables_html · layout_blocks" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="390" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad3" value="VietOCR adapter&lt;br&gt;vietocr_adapter.py · engine_name = &quot;vietocr&quot;&lt;br&gt;&lt;br&gt;PaddleOCR PP-OCRv5 used as the line DETECTOR;&lt;br&gt;each polygon crop is recognised by&lt;br&gt;vietocr Predictor (vgg_transformer, cfg.VIETOCR_DEVICE)&lt;br&gt;config from VIETOCR_CONFIG_PATH → MODEL_DIR → built-in defaults" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad4" value="GLM-OCR adapter&lt;br&gt;glm_adapter.py · engine_name = &quot;glmocr&quot;&lt;br&gt;&lt;br&gt;out-of-process client — see the panel below&lt;br&gt;layout_native = True (no geometric reordering)&lt;br&gt;returns markdown · tables_html · layout_blocks&lt;br&gt;· images (layout_vis + crops) · raw_json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1090" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad5" value="Hybrid adapter — glm_vietocr_adapter.py · engine_name = &quot;glm_vietocr&quot;&lt;br&gt;&lt;br&gt;composes GLMOCREngine (layout, reading order, labels, layout_vis) with VietOCREngine (line-level Vietnamese recognition on the same page image); every VietOCR line is assigned to the GLM block whose pixel box contains the line centre, lines are sorted top→bottom / left→right, and each block records recognition_source ∈ {vietocr, glm, fallback} plus fallback_reason." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="660" height="118" as="geometry"/></mxCell><mxCell id="glm" value="Out-of-process GLM-OCR integration  (glm_adapter.py)&lt;br&gt;&lt;br&gt;1.  Path(cfg.GLM_SDK_PYTHON).exists()  —  otherwise a structured error is returned&lt;br&gt;2.  TCP connect to cfg.GLM_OCR_API_URL (default http://localhost:8080), timeout 3 s&lt;br&gt;3.  child environment: HF_HOME / HF_HUB_CACHE / TRANSFORMERS_CACHE removed,&lt;br&gt;     HF_HUB_OFFLINE = 1, TRANSFORMERS_OFFLINE = 1&lt;br&gt;4.  subprocess.run([GLM_SDK_PYTHON, &quot;-m&quot;, &quot;glmocr.cli&quot;, &quot;parse&quot;, &lt;image&gt;,&lt;br&gt;     &quot;--config&quot;, GLM_CONFIG_YAML, &quot;--mode&quot;, &quot;selfhosted&quot;, &quot;--output&quot;, &lt;tmpdir&gt;],&lt;br&gt;     cwd = GLM_ROOT, timeout = cfg.GLM_TIMEOUT)&lt;br&gt;5.  read &lt;tmpdir&gt;/&lt;stem&gt;/: *.json (regions), *.md, layout_vis/*, imgs/*  → temp dir removed&lt;br&gt;6.  boxes converted from the 0–1000 normalised space to image pixels (_scale_box)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="512" width="660" height="190" as="geometry"/></mxCell><mxCell id="mlx" value="glmocr SDK internals (glm-ocr-server): PageLoader → PP-DocLayoutV3 layout detection →&lt;br&gt;per-region OCR request to the MLX server (OpenAI-compatible /chat/completions,&lt;br&gt;model mlx-community/GLM-OCR-bf16) → ResultFormatter (json + markdown)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="726" width="660" height="74" as="geometry"/></mxCell><mxCell id="norm" value="Common result normalisation  (ocr_service.run_ocr)&lt;br&gt;&lt;br&gt;• _normalize_block(): guarantees text, content, box, confidence on every block&lt;br&gt;• raw_results keeps the engine&#x27;s original order&lt;br&gt;• blocks WITH geometry → layout_service.reconstruct_layout(); blocks WITHOUT geometry are&lt;br&gt;  appended afterwards so no text is silently dropped&lt;br&gt;• layout_native = True (Modern, GLM, hybrid) skips the geometric reordering&lt;br&gt;• engines that produce no visual artifact get a generated overlay image&lt;br&gt;  (_render_overlay_image, colour-coded by confidence)&lt;br&gt;&lt;br&gt;Contract returned to app.py:&lt;br&gt;{success, results[{text, content, box, confidence, index}], img_width, img_height,&lt;br&gt; elapsed_ms, ocr_engine, inference_status, layout_native?, markdown?, html?,&lt;br&gt; tables_html?, layout_blocks?, images?, raw_json?}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="726" width="660" height="200" as="geometry"/></mxCell><mxCell id="n1" value="Integration facts: the five adapters are instantiated once at import time in router.py, so heavy models are loaded lazily on first use and then reused. Adding or replacing an engine means adding one OCREngine subclass and one entry in _ENGINES / _ALIASES — the upload API, the persistence code and the database schema are unaffected, because every engine returns the same result contract. The GLM path is the only one that leaves the Flask process, and it is also the only one that can fail because of a missing environment (SDK venv) or an unavailable model server." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1360" height="92" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="195" y="292"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="545" y="292"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="895" y="292"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="1245" y="292"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad1" target="ad5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="reuses both adapters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad4" target="ad5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="500"/><mxPoint x="370" y="500"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="glm" target="mlx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="abc" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad3" target="norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="712"/><mxPoint x="370" y="712"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad4" target="glm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="498"/><mxPoint x="1070" y="498"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>