<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 3.7 – Cơ chế tích hợp và điều phối các công cụ OCR" id="fig_3_7_ocr_orchestration"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 3.7 – Cơ chế tích hợp và điều phối các công cụ OCR" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1360" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="services/ocr_engines/ — một giao diện trừu tượng, năm bộ thích nghi, một hợp đồng kết quả chung" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1360" height="20" as="geometry"/></mxCell><mxCell id="req" value="Yêu cầu từ dịch vụ OCR&lt;br&gt;&lt;br&gt;smart_ocr_service.run_ocr_pipeline(&lt;br&gt;     image_path,&lt;br&gt;     engine_name)&lt;br&gt;&lt;br&gt;→ ocr_service.run_ocr()&lt;br&gt;     activity_registry.track(&quot;ocr&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="150" as="geometry"/></mxCell><mxCell id="router" value="BỘ ĐỊNH TUYẾN OCR   services/ocr_engines/router.py&lt;br&gt;&lt;br&gt;_ENGINES = {paddleocr, vietocr, paddleocr_modern, glmocr, glm_vietocr}&lt;br&gt;_ALIASES  (paddle, auto, modern, ppstructure, glm, glm_ocr, glm_layout_vietocr)&lt;br&gt;normalize_engine_name() → get_engine() → engine.run(image_path)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="128" width="560" height="114" as="geometry"/></mxCell><mxCell id="abc" value="Giao diện trừu tượng&lt;br&gt;services/ocr_engines/base.py&lt;br&gt;&lt;br&gt;class OCREngine(ABC):&lt;br&gt;     engine_name: str&lt;br&gt;     def run(self, image_path) -&gt; dict" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="128" width="340" height="114" as="geometry"/></mxCell><mxCell id="ad1" value="Bộ thích nghi PaddleOCR Legacy&lt;br&gt;paddle_adapter.py · engine_name = &quot;paddleocr&quot;&lt;br&gt;&lt;br&gt;khởi tạo trễ PaddleOCR(ocr_version=&quot;PP-OCRv5&quot;,&lt;br&gt; use_doc_orientation_classify=False,&lt;br&gt; use_doc_unwarping=False)&lt;br&gt;chạy trong tiến trình · trả rec_texts / rec_scores / det_polys" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad2" value="Bộ thích nghi PaddleOCR Modern&lt;br&gt;paddle_modern_adapter.py · &quot;paddleocr_modern&quot;&lt;br&gt;&lt;br&gt;khởi tạo trễ PPStructureV3(use_doc_orientation_classify=True,&lt;br&gt; use_doc_unwarping=True,&lt;br&gt; text_detection_model_name=&quot;PP-OCRv6_medium_det&quot;,&lt;br&gt; text_recognition_model_name=&quot;PP-OCRv6_medium_rec&quot;)&lt;br&gt;bổ sung markdown · html · tables_html · layout_blocks" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="390" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad3" value="Bộ thích nghi VietOCR&lt;br&gt;vietocr_adapter.py · engine_name = &quot;vietocr&quot;&lt;br&gt;&lt;br&gt;PaddleOCR PP-OCRv5 đóng vai trò BỘ PHÁT HIỆN dòng;&lt;br&gt;mỗi vùng cắt được nhận dạng bằng&lt;br&gt;vietocr Predictor (vgg_transformer, cfg.VIETOCR_DEVICE)&lt;br&gt;cấu hình lấy theo VIETOCR_CONFIG_PATH → MODEL_DIR → mặc định nội bộ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad4" value="Bộ thích nghi GLM-OCR&lt;br&gt;glm_adapter.py · engine_name = &quot;glmocr&quot;&lt;br&gt;&lt;br&gt;chạy ngoài tiến trình — xem khung bên dưới&lt;br&gt;layout_native = True (không sắp lại theo hình học)&lt;br&gt;trả markdown · tables_html · layout_blocks&lt;br&gt;· images (layout_vis + ảnh cắt) · raw_json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1090" y="316" width="310" height="168" as="geometry"/></mxCell><mxCell id="ad5" value="Bộ thích nghi lai — glm_vietocr_adapter.py · engine_name = &quot;glm_vietocr&quot;&lt;br&gt;&lt;br&gt;kết hợp GLMOCREngine (bố cục, thứ tự đọc, nhãn vùng, layout_vis) với VietOCREngine (nhận dạng tiếng Việt ở mức dòng trên cùng ảnh trang); mỗi dòng VietOCR được gán vào khối GLM có khung bao chứa tâm dòng, các dòng được sắp trên→dưới / trái→phải, và mỗi khối ghi lại recognition_source ∈ {vietocr, glm, fallback} kèm fallback_reason." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="660" height="118" as="geometry"/></mxCell><mxCell id="glm" value="Tích hợp GLM-OCR ngoài tiến trình  (glm_adapter.py)&lt;br&gt;&lt;br&gt;1.  Path(cfg.GLM_SDK_PYTHON).exists()  —  nếu không thì trả về lỗi có cấu trúc&lt;br&gt;2.  kết nối TCP tới cfg.GLM_OCR_API_URL (mặc định http://localhost:8080), timeout 3 giây&lt;br&gt;3.  môi trường tiến trình con: gỡ HF_HOME / HF_HUB_CACHE / TRANSFORMERS_CACHE,&lt;br&gt;     đặt HF_HUB_OFFLINE = 1 và TRANSFORMERS_OFFLINE = 1&lt;br&gt;4.  subprocess.run([GLM_SDK_PYTHON, &quot;-m&quot;, &quot;glmocr.cli&quot;, &quot;parse&quot;, &lt;ảnh&gt;,&lt;br&gt;     &quot;--config&quot;, GLM_CONFIG_YAML, &quot;--mode&quot;, &quot;selfhosted&quot;, &quot;--output&quot;, &lt;thư mục tạm&gt;],&lt;br&gt;     cwd = GLM_ROOT, timeout = cfg.GLM_TIMEOUT)&lt;br&gt;5.  đọc &lt;tmp&gt;/&lt;stem&gt;/: *.json (vùng), *.md, layout_vis/*, imgs/*  → xóa thư mục tạm&lt;br&gt;6.  quy đổi khung bao từ hệ chuẩn hóa 0–1000 sang pixel ảnh (_scale_box)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="512" width="660" height="190" as="geometry"/></mxCell><mxCell id="mlx" value="Bên trong SDK glmocr (glm-ocr-server): PageLoader → phát hiện bố cục PP-DocLayoutV3 →&lt;br&gt;gửi yêu cầu OCR theo từng vùng tới máy chủ MLX (chuẩn OpenAI /chat/completions,&lt;br&gt;mô hình mlx-community/GLM-OCR-bf16) → ResultFormatter (json + markdown)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="740" y="726" width="660" height="74" as="geometry"/></mxCell><mxCell id="norm" value="Chuẩn hóa kết quả dùng chung  (ocr_service.run_ocr)&lt;br&gt;&lt;br&gt;• _normalize_block(): bảo đảm mọi khối đều có text, content, box, confidence&lt;br&gt;• raw_results giữ lại thứ tự gốc do công cụ trả về&lt;br&gt;• khối CÓ tọa độ → layout_service.reconstruct_layout(); khối KHÔNG có tọa độ được&lt;br&gt;  nối vào sau nên không đoạn văn bản nào bị bỏ sót&lt;br&gt;• layout_native = True (Modern, GLM, lai) thì bỏ qua bước sắp lại theo hình học&lt;br&gt;• công cụ không tự sinh ảnh minh họa sẽ được vẽ ảnh phủ vùng&lt;br&gt;  (_render_overlay_image, tô màu theo độ tin cậy)&lt;br&gt;&lt;br&gt;Hợp đồng trả về cho app.py:&lt;br&gt;{success, results[{text, content, box, confidence, index}], img_width, img_height,&lt;br&gt; elapsed_ms, ocr_engine, inference_status, layout_native?, markdown?, html?,&lt;br&gt; tables_html?, layout_blocks?, images?, raw_json?}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="726" width="660" height="200" as="geometry"/></mxCell><mxCell id="n1" value="Dữ kiện về tích hợp: năm bộ thích nghi được khởi tạo một lần lúc nạp router.py, nên các mô hình nặng chỉ được nạp ở lần dùng đầu tiên rồi tái sử dụng. Thêm hoặc thay một công cụ OCR chỉ cần thêm một lớp con OCREngine và một mục trong _ENGINES / _ALIASES — API tải tệp, phần lưu trữ và lược đồ cơ sở dữ liệu đều không đổi, vì mọi công cụ trả về cùng một hợp đồng kết quả. Nhánh GLM là nhánh duy nhất rời khỏi tiến trình Flask, và cũng là nhánh duy nhất có thể hỏng vì thiếu môi trường (venv SDK) hoặc vì máy chủ mô hình không chạy." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1360" height="92" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="195" y="292"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="545" y="292"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="895" y="292"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="ad4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="292"/><mxPoint x="1245" y="292"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad1" target="ad5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="dùng lại cả hai bộ thích nghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad4" target="ad5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="500"/><mxPoint x="370" y="500"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="glm" target="mlx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="hiện thực" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="abc" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#82B366;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad3" target="norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="712"/><mxPoint x="370" y="712"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad4" target="glm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="498"/><mxPoint x="1070" y="498"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>