<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.2 – Biểu đồ ngữ cảnh của hệ thống số hóa tài liệu" id="fig_2_2_context"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.2 – Biểu đồ ngữ cảnh của hệ thống số hóa tài liệu" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1260" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Phạm vi hệ thống và các tác nhân / tiến trình / vùng dữ liệu bên ngoài thực sự có trong kho mã nguồn" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1260" height="20" as="geometry"/></mxCell><mxCell id="sys" value="Hệ thống số hóa tài liệu&lt;br&gt;Ứng dụng web SmartDocs  (glm-ocr-ui, Flask :5001)&lt;br&gt;app.py · auth.py · admin_bp.py · correction_bp.py" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="336" width="440" height="150" as="geometry"/></mxCell><mxCell id="user" value="Người dùng" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;outlineConnect=0;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="130" y="118" width="130" height="96" as="geometry"/></mxCell><mxCell id="admin" value="Quản trị viên" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;outlineConnect=0;whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1040" y="118" width="130" height="96" as="geometry"/></mxCell><mxCell id="paddle" value="Công cụ OCR chạy trong tiến trình&lt;br&gt;PaddleOCR (PP-OCRv5)&lt;br&gt;PP-StructureV3 (PP-OCRv6)&lt;br&gt;VietOCR (vgg_transformer)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="300" height="116" as="geometry"/></mxCell><mxCell id="glmcli" value="Tiến trình con GLM-OCR SDK&lt;br&gt;glm-ocr-server/.venv-sdk · glmocr.cli parse" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="470" y="574" width="360" height="74" as="geometry"/></mxCell><mxCell id="mlx" value="Máy chủ mô hình GLM-OCR MLX&lt;br&gt;http://localhost:8080 · mlx-community/GLM-OCR-bf16" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="470" y="700" width="360" height="74" as="geometry"/></mxCell><mxCell id="store" value="Vùng dữ liệu&lt;br&gt;SQLite  paddleocr.db&lt;br&gt;uploads/  (tệp gốc đặt tên theo UUID)&lt;br&gt;models/  (kho mô hình cục bộ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="940" y="590" width="320" height="116" as="geometry"/></mxCell><mxCell id="pandoc" value="Chương trình pandoc&lt;br&gt;(Markdown → xuất DOCX)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1000" y="336" width="260" height="70" as="geometry"/></mxCell><mxCell id="n1" value="Nhánh GLM-OCR là tùy chọn và chỉ chạy trên Apple Silicon: config.py phân giải GLM_ROOT / GLM_SDK_PYTHON / GLM_OCR_API_URL, còn glm_adapter.py từ chối chạy khi thiếu môi trường ảo SDK hoặc khi không có tiến trình nào lắng nghe ở cổng MLX. Nhánh OCR đám mây (MaaS) bị tắt — mlx_config.yaml đặt pipeline.maas.enabled: false." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="60" y="792" width="1220" height="62" as="geometry"/></mxCell><mxCell id="e0" value="→  Tài khoản, tài liệu, yêu cầu OCR&lt;br&gt;←  Trạng thái, kết quả, lịch sử" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="user" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="→  Quản lý tài khoản, truy vấn nhật ký / tệp&lt;br&gt;←  Nhật ký, thống kê, trạng thái hệ thống" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="→  Ảnh trang đã chuẩn hóa&lt;br&gt;←  Khối văn bản, khung bao, độ tin cậy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="sys" target="paddle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="→  Ảnh trang + tham số dòng lệnh&lt;br&gt;←  JSON / Markdown / layout_vis / imgs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="sys" target="glmcli"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="→  HTTP /chat/completions (theo từng vùng)&lt;br&gt;←  Nội dung vùng đã nhận dạng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="glmcli" target="mlx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="→  Tệp gốc, kết xuất, bản ghi&lt;br&gt;←  Tài liệu và kết xuất đã lưu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="sys" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="→  Markdown    ←  .docx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#999999;labelBackgroundColor=#FFFFFF;startArrow=block;" edge="1" parent="1" source="sys" target="pandoc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>