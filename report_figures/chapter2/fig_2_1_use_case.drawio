<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.1 – Biểu đồ ca sử dụng tổng quát của hệ thống" id="fig_2_1_use_case"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.1 – Biểu đồ ca sử dụng tổng quát của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1220" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="General use case diagram — derived from the Flask routes in app.py, auth.py, admin_bp.py and correction_bp.py" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1220" height="20" as="geometry"/></mxCell><mxCell id="sys" value="SmartDocs Web Application  (glm-ocr-ui, Flask :5001)" style="swimlane;rounded=1;arcSize=4;startSize=38;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F0F6FD;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="240" y="92" width="800" height="826" as="geometry"/></mxCell><mxCell id="act_user" value="User&lt;br&gt;(role = &quot;user&quot;)" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;outlineConnect=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="130" height="96" as="geometry"/></mxCell><mxCell id="act_admin" value="Administrator&lt;br&gt;(role = &quot;admin&quot;)" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;outlineConnect=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="130" height="96" as="geometry"/></mxCell><mxCell id="u1" value="Log in / Log out&lt;br&gt;/login · /logout" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="146" width="330" height="46" as="geometry"/></mxCell><mxCell id="u2" value="Upload document&lt;br&gt;POST /api/upload" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="200" width="330" height="46" as="geometry"/></mxCell><mxCell id="u3" value="Preview page / navigate pages&lt;br&gt;POST /api/ocr/page (preview_only)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="254" width="330" height="46" as="geometry"/></mxCell><mxCell id="u4" value="Select OCR engine&lt;br&gt;(engine parameter)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="308" width="330" height="46" as="geometry"/></mxCell><mxCell id="u5" value="Run OCR on one page&lt;br&gt;POST /api/ocr/page" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="362" width="330" height="46" as="geometry"/></mxCell><mxCell id="u6" value="Run OCR on all pages&lt;br&gt;POST /api/ocr/all" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="416" width="330" height="46" as="geometry"/></mxCell><mxCell id="u7" value="Re-order a selected region&lt;br&gt;POST /api/ocr/reconstruct-region" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="470" width="330" height="46" as="geometry"/></mxCell><mxCell id="u8" value="Read text from TXT / DOCX / PDF&lt;br&gt;POST /api/read-text" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="524" width="330" height="46" as="geometry"/></mxCell><mxCell id="u9" value="View results (Markdown · Raw ·&lt;br&gt;Images · JSON)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="578" width="330" height="46" as="geometry"/></mxCell><mxCell id="u10" value="Copy / download results&lt;br&gt;.md · .txt · .json · .docx" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="632" width="330" height="46" as="geometry"/></mxCell><mxCell id="u11" value="Manage own document library&lt;br&gt;GET/DELETE /api/documents" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="686" width="330" height="46" as="geometry"/></mxCell><mxCell id="u12" value="Run Vietnamese OCR correction&lt;br&gt;POST /api/correction/run" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="740" width="330" height="46" as="geometry"/></mxCell><mxCell id="u13" value="Save / reload corrected result&lt;br&gt;/api/correction/save · /result" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="794" width="330" height="46" as="geometry"/></mxCell><mxCell id="u14" value="Switch UI language&lt;br&gt;POST /api/set-lang" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#