<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.1 – Biểu đồ ca sử dụng tổng quát của hệ thống" id="fig_2_1_use_case"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.1 – Biểu đồ ca sử dụng tổng quát của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1220" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Rút ra từ các tuyến (route) Flask trong app.py, auth.py, admin_bp.py và correction_bp.py" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1220" height="20" as="geometry"/></mxCell><mxCell id="sys" value="Ứng dụng web SmartDocs  (glm-ocr-ui, Flask :5001)" style="swimlane;rounded=1;arcSize=4;startSize=38;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F0F6FD;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="240" y="92" width="800" height="826" as="geometry"/></mxCell><mxCell id="act_user" value="Người dùng&lt;br&gt;(role = &quot;user&quot;)" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;outlineConnect=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="130" height="96" as="geometry"/></mxCell><mxCell id="act_admin" value="Quản trị viên&lt;br&gt;(role = &quot;admin&quot;)" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;outlineConnect=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#33475B;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="130" height="96" as="geometry"/></mxCell><mxCell id="u1" value="Đăng nhập / Đăng xuất&lt;br&gt;/login · /logout" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="146" width="330" height="46" as="geometry"/></mxCell><mxCell id="u2" value="Tải tài liệu lên&lt;br&gt;POST /api/upload" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="200" width="330" height="46" as="geometry"/></mxCell><mxCell id="u3" value="Xem trước và chuyển trang&lt;br&gt;POST /api/ocr/page (preview_only)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="254" width="330" height="46" as="geometry"/></mxCell><mxCell id="u4" value="Lựa chọn công cụ OCR&lt;br&gt;(tham số engine)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="308" width="330" height="46" as="geometry"/></mxCell><mxCell id="u5" value="Thực hiện OCR một trang&lt;br&gt;POST /api/ocr/page" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="362" width="330" height="46" as="geometry"/></mxCell><mxCell id="u6" value="Thực hiện OCR toàn bộ trang&lt;br&gt;POST /api/ocr/all" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="416" width="330" height="46" as="geometry"/></mxCell><mxCell id="u7" value="Sắp xếp lại một vùng đã chọn&lt;br&gt;POST /api/ocr/reconstruct-region" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="470" width="330" height="46" as="geometry"/></mxCell><mxCell id="u8" value="Đọc văn bản từ TXT / DOCX / PDF&lt;br&gt;POST /api/read-text" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="524" width="330" height="46" as="geometry"/></mxCell><mxCell id="u9" value="Xem kết quả (Markdown · Raw ·&lt;br&gt;Images · JSON)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="578" width="330" height="46" as="geometry"/></mxCell><mxCell id="u10" value="Sao chép và tải kết quả&lt;br&gt;.md · .txt · .json · .docx" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="632" width="330" height="46" as="geometry"/></mxCell><mxCell id="u11" value="Quản lý tài liệu của mình&lt;br&gt;GET/DELETE /api/documents" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="686" width="330" height="46" as="geometry"/></mxCell><mxCell id="u12" value="Chạy hiệu chỉnh tiếng Việt&lt;br&gt;POST /api/correction/run" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="740" width="330" height="46" as="geometry"/></mxCell><mxCell id="u13" value="Lưu và mở lại bản đã hiệu chỉnh&lt;br&gt;/api/correction/save · /result" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="794" width="330" height="46" as="geometry"/></mxCell><mxCell id="u14" value="Đổi ngôn ngữ giao diện&lt;br&gt;POST /api/set-lang" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="276" y="848" width="330" height="46" as="geometry"/></mxCell><mxCell id="a1" value="Xem trang tổng quan quản trị&lt;br&gt;GET /admin/" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="350" height="66" as="geometry"/></mxCell><mxCell id="a2" value="Quản lý tài khoản người dùng&lt;br&gt;tạo · sửa · đặt lại mật khẩu&lt;br&gt;khóa/mở khóa · xóa" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="660" y="396" width="350" height="66" as="geometry"/></mxCell><mxCell id="a3" value="Giám sát toàn bộ tài liệu&lt;br&gt;GET /admin/files" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="660" y="492" width="350" height="66" as="geometry"/></mxCell><mxCell id="a4" value="Xem nhật ký hoạt động&lt;br&gt;GET /admin/logs" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="660" y="588" width="350" height="66" as="geometry"/></mxCell><mxCell id="a5" value="Truy cập tài liệu của mọi người dùng&lt;br&gt;(ngoại lệ trong kiểm tra quyền sở hữu)" style="ellipse;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="660" y="684" width="350" height="66" as="geometry"/></mxCell><mxCell id="n1" value="Ghi chú phạm vi: hệ thống không có màn hình &quot;cấu hình OCR&quot; trong ứng dụng — các giá trị mặc định của công cụ OCR được đặt bằng biến môi trường do config.py đọc (OCR_ENGINE, VIETOCR_*, GLM_*, VI_CORRECTION_*). Vì vậy không có ca sử dụng tương ứng." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="240" y="1000" width="800" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=none;strokeColor=#33475B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_user" target="u1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=none;strokeColor=#33475B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_user" target="u2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=none;strokeColor=#33475B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_user" target="u3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=none;strokeColor=#33475B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_user" target="u4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=none;strokeColor=#33475B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_user" target="u5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=none;strokeColor=#33475B;labelBackgroundColor=#FFFFFF;exitX=