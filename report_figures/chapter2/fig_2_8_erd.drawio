<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.8 – Sơ đồ quan hệ thực thể của hệ thống" id="fig_2_8_erd"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.8 – Sơ đồ quan hệ thực thể của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1260" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Sơ đồ quan hệ thực thể của các mô hình SQLAlchemy trong models.py (SQLite, sinh bởi db.create_all())" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1260" height="20" as="geometry"/></mxCell><mxCell id="legacy" value="Đã khai báo, không dùng ở bản này" style="swimlane;rounded=1;arcSize=4;startSize=32;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#F5F5F5;strokeColor=#999999;swimlaneFillColor=#FBFBFB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="330" height="300" as="geometry"/></mxCell><mxCell id="t1" value="chat_conversations" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="46" width="286" height="38" as="geometry"/></mxCell><mxCell id="t2" value="chat_messages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="94" width="286" height="38" as="geometry"/></mxCell><mxCell id="t3" value="agent_conversations" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="142" width="286" height="38" as="geometry"/></mxCell><mxCell id="t4" value="agent_messages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="190" width="286" height="38" as="geometry"/></mxCell><mxCell id="t5" value="agent_artifacts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="238" width="286" height="38" as="geometry"/></mxCell><mxCell id="n1" value="Ghi chú đối chiếu — phần thuyết minh đề xuất các thực thể User, Role, Document, DocumentPage, OCRJob, OCRResult, OCRConfiguration, ActivityLog và ErrorLog. Mã nguồn chỉ có bốn bảng vẽ ở trên: không có bảng Role (role là một cột chuỗi trong bảng users), không có DocumentPage, OCRJob, OCRResult, OCRConfiguration hay ErrorLog. Kết quả OCR theo từng trang được lưu dưới dạng JSON trong document_artifacts, tham số công cụ OCR nằm trong biến môi trường do config.py đọc, còn lỗi được ghi vào nhật ký ứng dụng và bảng activity_logs." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="70" y="762" width="1210" height="96" as="geometry"/></mxCell><mxCell id="n2" value="Năm bảng bên phải được khai báo trong models.py nên vẫn được db.create_all() tạo ra, nhưng không tuyến nào của phiên bản này đọc hay ghi chúng — các blueprint trò chuyện / RAG / tác tử đã bị gỡ bỏ (xem chú thích trong app.py::_persist_and_index). Chúng được vẽ để mô tả đầy đủ lược đồ vật lý và không được trình bày như chức năng đang hoạt động." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="70" y="878" width="1210" height="76" as="geometry"/></mxCell><mxCell id="users" value="users  (người dùng)" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#D4E1F5;strokeColor=#3F61A8;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="330" height="181" as="geometry"/></mxCell><mxCell id="users_r0" value="PK  id : Integer  &lt;b&gt;PK&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="28" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r1" value="username : String(80)  &lt;b&gt;UNIQUE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="49" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r2" value="email : String(120)  &lt;b&gt;UNIQUE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="70" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r3" value="password_hash : String(256)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="91" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r4" value="role : String(20) = &quot;user&quot;  &lt;b&gt;&#x27;admin&#x27;|&#x27;user&#x27;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="112" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r5" value="is_active : Boolean = True" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="133" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r6" value="created_at : DateTime (UTC)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="154" width="330" height="21" as="geometry"/></mxCell><mxCell id="documents" value="documents  (tài liệu)" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="360" height="223" as="geometry"/></mxCell><mxCell id="documents_r0" value="PK  id : Integer  &lt;b&gt;PK&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="28" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r1" value="FK  user_id → users.id  &lt;b&gt;NOT NULL, idx&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="49" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r2" value="filename : String(255)  &lt;b&gt;tên hiển thị&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="70" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r3" value="file_id : String(36)  &lt;b&gt;UNIQUE (uuid4)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="91" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r4" value="file_type : String(10)  &lt;b&gt;phần mở rộng&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="112" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r5" value="file_size : BigInteger" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="133" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r6" value="page_count : Integer = 1" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="154" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r7" value="upload_date : DateTime (UTC)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="175" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r8" value="status : String(20)  &lt;b&gt;uploaded|ocr_done&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="196" width="360" height="21" as="geometry"/></mxCell><mxCell id="artifacts" value="document_artifacts  (kết xuất)" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#B0E3E6;strokeColor=#0E8088;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="110" width="330" height="202" as="geometry"/></mxCell><mxCell id="artifacts_r0" value="PK  id : Integer  &lt;b&gt;PK&lt;/b&gt;" style=