<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.8 – Sơ đồ quan hệ thực thể của hệ thống" id="fig_2_8_erd"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.8 – Sơ đồ quan hệ thực thể của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1260" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Entity-relationship diagram of the SQLAlchemy models in models.py (SQLite, created by db.create_all())" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1260" height="20" as="geometry"/></mxCell><mxCell id="legacy" value="Declared but unused in this build" style="swimlane;rounded=1;arcSize=4;startSize=32;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#F5F5F5;strokeColor=#999999;swimlaneFillColor=#FBFBFB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="330" height="300" as="geometry"/></mxCell><mxCell id="t1" value="chat_conversations" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="46" width="286" height="38" as="geometry"/></mxCell><mxCell id="t2" value="chat_messages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="94" width="286" height="38" as="geometry"/></mxCell><mxCell id="t3" value="agent_conversations" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="142" width="286" height="38" as="geometry"/></mxCell><mxCell id="t4" value="agent_messages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="190" width="286" height="38" as="geometry"/></mxCell><mxCell id="t5" value="agent_artifacts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="legacy"><mxGeometry x="22" y="238" width="286" height="38" as="geometry"/></mxCell><mxCell id="n1" value="Fidelity note — the report text suggests the entities User, Role, Document, DocumentPage, OCRJob, OCRResult, OCRConfiguration, ActivityLog and ErrorLog. The implementation contains only the four tables drawn above: there is no Role table (role is a string column on users), no DocumentPage, OCRJob, OCRResult, OCRConfiguration or ErrorLog table. Per-page OCR output is stored as JSON inside document_artifacts, OCR engine settings live in environment variables read by config.py, and errors are recorded in the application log and in activity_logs." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="70" y="762" width="1210" height="96" as="geometry"/></mxCell><mxCell id="n2" value="The five tables on the right are defined in models.py and are therefore created by db.create_all(), but no route in this build reads or writes them — the chat / RAG / agent blueprints were removed (see the comment in app.py::_persist_and_index). They are shown for completeness of the physical schema and must not be presented as active functionality." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="70" y="878" width="1210" height="76" as="geometry"/></mxCell><mxCell id="users" value="users" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#D4E1F5;strokeColor=#3F61A8;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="330" height="181" as="geometry"/></mxCell><mxCell id="users_r0" value="PK  id : Integer  &lt;b&gt;PK&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="28" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r1" value="username : String(80)  &lt;b&gt;UNIQUE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="49" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r2" value="email : String(120)  &lt;b&gt;UNIQUE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="70" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r3" value="password_hash : String(256)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="91" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r4" value="role : String(20) = &quot;user&quot;  &lt;b&gt;&#x27;admin&#x27;|&#x27;user&#x27;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="112" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r5" value="is_active : Boolean = True" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="133" width="330" height="21" as="geometry"/></mxCell><mxCell id="users_r6" value="created_at : DateTime (UTC)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="users"><mxGeometry x="0" y="154" width="330" height="21" as="geometry"/></mxCell><mxCell id="documents" value="documents" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="360" height="223" as="geometry"/></mxCell><mxCell id="documents_r0" value="PK  id : Integer  &lt;b&gt;PK&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="28" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r1" value="FK  user_id → users.id  &lt;b&gt;NOT NULL, idx&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="49" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r2" value="filename : String(255)  &lt;b&gt;display name&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="0" y="70" width="360" height="21" as="geometry"/></mxCell><mxCell id="documents_r3" value="file_id : String(36)  &lt;b&gt;UNIQUE (uuid4)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="documents"><mxGeometry x="