rtifacts"><mxGeometry x="0" y="154" width="330" height="21" as="geometry"/></mxCell><mxCell id="artifacts_r7" value="UNIQUE (document_id, kind)  &lt;b&gt;uq_artifact_doc_kind&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="artifacts"><mxGeometry x="0" y="175" width="330" height="21" as="geometry"/></mxCell><mxCell id="logs" value="activity_logs  (nhật ký hoạt động)" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#EDEDED;strokeColor=#5A5A5A;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="330" height="160" as="geometry"/></mxCell><mxCell id="logs_r0" value="PK  id : Integer  &lt;b&gt;PK&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="logs"><mxGeometry x="0" y="28" width="330" height="21" as="geometry"/></mxCell><mxCell id="logs_r1" value="FK  user_id → users.id  &lt;b&gt;ON DELETE SET NULL&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="logs"><mxGeometry x="0" y="49" width="330" height="21" as="geometry"/></mxCell><mxCell id="logs_r2" value="action : String(50)  &lt;b&gt;NOT NULL&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="logs"><mxGeometry x="0" y="70" width="330" height="21" as="geometry"/></mxCell><mxCell id="logs_r3" value="detail : String(500)  &lt;b&gt;có thể NULL&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="logs"><mxGeometry x="0" y="91" width="330" height="21" as="geometry"/></mxCell><mxCell id="logs_r4" value="ip_address : String(45)  &lt;b&gt;request.remote_addr&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="logs"><mxGeometry x="0" y="112" width="330" height="21" as="geometry"/></mxCell><mxCell id="logs_r5" value="created_at : DateTime (UTC)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="logs"><mxGeometry x="0" y="133" width="330" height="21" as="geometry"/></mxCell><mxCell id="kinds" value="Các giá trị document_artifacts.kind mà mã nguồn ghi ra" style="swimlane;rounded=1;arcSize=6;startSize=28;html=1;fontSize=13;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;fontColor=#10202E;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="360" height="234" as="geometry"/></mxCell><mxCell id="kinds_r0" value="text  —  văn bản TXT / DOCX / PDF (/api/read-text)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="28" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r1" value="ocr  —  văn bản OCR đã làm phẳng" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="48" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r2" value="ocr_layout  —  khung bao, độ tin cậy, thời gian  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="68" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r3" value="ocr_json  —  vùng nhận dạng theo từng trang  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="88" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r4" value="ocr_markdown  —  bản dựng lại dạng Markdown  &lt;b&gt;GLM / Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="108" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r5" value="ocr_html  —  bản dựng lại dạng HTML  &lt;b&gt;Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="128" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r6" value="ocr_tables  —  bảng phát hiện được, dạng HTML  &lt;b&gt;GLM / Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="148" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r7" value="ocr_blocks  —  khối bố cục (nhãn/bbox/thứ tự)  &lt;b&gt;GLM / Modern&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="168" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r8" value="ocr_images  —  ảnh phủ vùng + ảnh cắt (base64)  &lt;b&gt;mọi công cụ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="188" width="360" height="20" as="geometry"/></mxCell><mxCell id="kinds_r9" value="corrected_json / corrected_md / corrected_meta  &lt;b&gt;correction_bp&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;fontColor=#243B4A;" vertex="1" parent="kinds"><mxGeometry x="0" y="208" width="360" height="20" as="geometry"/></mxCell><mxCell id="e0" value="1 ── 0..*  sở hữu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="documents"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="1 ── 0..*  sinh ra&lt;br&gt;(xóa theo tài liệu)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="documents" target="artifacts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="1 ── 0..*  thực hiện&lt;br&gt;(user_id có thể NULL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="logs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>