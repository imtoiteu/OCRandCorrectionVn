d" value="Bmd1905Provider&lt;br&gt;vietnamese-correction-v2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="l4b"><mxGeometry x="296" y="44" width="254" height="48" as="geometry"/></mxCell><mxCell id="p_mock" value="MockProvider" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="l4b"><mxGeometry x="22" y="100" width="254" height="44" as="geometry"/></mxCell><mxCell id="p_mr" value="MrlasdtProvider (có trong registry)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="l4b"><mxGeometry x="296" y="100" width="254" height="44" as="geometry"/></mxCell><mxCell id="glmsdk" value="glmocr CLI  ·  .venv-sdk&lt;br&gt;phát hiện bố cục PP-DocLayoutV3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="ext"><mxGeometry x="22" y="44" width="336" height="48" as="geometry"/></mxCell><mxCell id="mlxsrv" value="Máy chủ MLX :8080  ·  .venv-mlx&lt;br&gt;mlx-community/GLM-OCR-bf16" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="ext"><mxGeometry x="22" y="100" width="336" height="44" as="geometry"/></mxCell><mxCell id="db" value="SQLite&lt;br&gt;paddleocr.db&lt;br&gt;(cfg.DB_PATH)" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="22" y="54" width="256" height="80" as="geometry"/></mxCell><mxCell id="up" value="uploads/&lt;br&gt;{uuid4}{suffix}&lt;br&gt;(cfg.UPLOAD_DIR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="22" y="146" width="256" height="76" as="geometry"/></mxCell><mxCell id="mdl" value="models/  +  bộ nhớ đệm HF&lt;br&gt;(cfg.MODEL_DIR;&lt;br&gt;OFFLINE=1 chặn tải về)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="22" y="234" width="256" height="80" as="geometry"/></mxCell><mxCell id="dnote" value="Chỉ truy cập qua models.py /&lt;br&gt;SQLAlchemy và thao tác tệp&lt;br&gt;trong app.py&lt;br&gt;&lt;br&gt;Lược đồ vật lý (models.py)&lt;br&gt;• users&lt;br&gt;• documents&lt;br&gt;• document_artifacts&lt;br&gt;• activity_logs&lt;br&gt;&lt;br&gt;Phiên bản này không dùng máy chủ&lt;br&gt;cơ sở dữ liệu riêng, kho đối tượng,&lt;br&gt;bộ nhớ đệm hay hàng đợi." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="data"><mxGeometry x="22" y="326" width="256" height="250" as="geometry"/></mxCell><mxCell id="n1" value="Không có trong kho mã nguồn nên không được vẽ: ứng dụng desktop Tauri/Rust và các mô-đun trò chuyện RAG, dịch, tóm tắt, tác tử LLM được nhắc tới trong README.md và docs/. Hình chỉ thể hiện các thành phần thực sự tồn tại trong mã của phiên bản này." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="1062" width="1320" height="52" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="corrpage" target="corrbp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FF