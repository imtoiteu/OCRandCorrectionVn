ll><mxCell id="nav" value="Persistent navigation bar&lt;br&gt;Home · OCR · Documents · [Admin] · language · Sign out" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="spa"><mxGeometry x="26" y="374" width="584" height="64" as="geometry"/></mxCell><mxCell id="adash" value="GET /admin/&lt;br&gt;Dashboard + recent activity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="admin"><mxGeometry x="26" y="54" width="280" height="54" as="geometry"/></mxCell><mxCell id="alogs" value="GET /admin/logs&lt;br&gt;Activity logs (filters)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="admin"><mxGeometry x="330" y="54" width="280" height="54" as="geometry"/></mxCell><mxCell id="ausers" value="GET /admin/users&lt;br&gt;User management" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="admin"><mxGeometry x="26" y="128" width="280" height="54" as="geometry"/></mxCell><mxCell id="afiles" value="GET /admin/files&lt;br&gt;All documents" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;" vertex="1" parent="admin"><mxGeometry x="330" y="128" width="280" height="54" as="geometry"/></mxCell><mxCell id="corr" value="Correction page&lt;br&gt;GET /correction&lt;br&gt;(separate page; reachable by URL,&lt;br&gt;&quot;← Back to SmartDocs&quot; link)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="270" height="100" as="geometry"/></mxCell><mxCell id="f403" value="403 page&lt;br&gt;templates/403.html&lt;br&gt;(non-admin access)" style="rounded=