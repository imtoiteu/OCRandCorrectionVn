<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.9 – Sơ đồ điều hướng chính của giao diện người dùng" id="fig_2_9_navigation"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.9 – Sơ đồ điều hướng chính của giao diện người dùng" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1260" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Reconstructed from the Flask routes and the hash router in static/app.js (Router.register / Router.goto / Router._render)" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1260" height="20" as="geometry"/></mxCell><mxCell id="spa" value="Single-page application  —  GET /   (static/index.html)" style="swimlane;rounded=1;arcSize=4;startSize=36;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F0F6FD;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="96" width="640" height="466" as="geometry"/></mxCell><mxCell id="admin" value="Admin console  —  server-rendered Jinja pages, role = &quot;admin&quot; only" style="swimlane;rounded=1;arcSize=4;startSize=36;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#D4E1F5;strokeColor=#3F61A8;swimlaneFillColor=#EEF3FB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="640" height="220" as="geometry"/></mxCell><mxCell id="login" value="Login page&lt;br&gt;GET / POST  /login" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontCol