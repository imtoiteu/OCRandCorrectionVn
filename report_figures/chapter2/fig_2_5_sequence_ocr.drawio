<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.5 – Biểu đồ tuần tự quá trình xử lý một yêu cầu OCR" id="fig_2_5_sequence_ocr"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1276" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.5 – Biểu đồ tuần tự quá trình xử lý một yêu cầu OCR" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1300" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Lần theo app.py (/api/upload, /api/ocr/page), ocr_service.py, services/ocr_engines/router.py, glm_adapter.py và models.py" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/></mxCell><mxCell id="u" value="Người dùng&lt;br&gt;(SPA trên trình duyệt)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;fontStyle=1;fontSize=12;size=54;" vertex="1" parent="1"><mxGeometry x="31" y="100" width="178" height="1118" as="geometry"/></mxCell><mxCell id="api" value="Flask app.py&lt;br&gt;hàm xử lý tuyến" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;fontSize=12;size=54;" vertex="1" parent="1"><mxGeometry x="241" y="100" width="178" height="1118" as="geometry"/></mxCell><mxCell id="svc" value="ocr_service /&lt;br&gt;smart_ocr_service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;fontStyle=1;fontSize=12;size=54;" vertex="1" parent="1"><mxGeometry x="461" y="100" width="178" height="1118" a