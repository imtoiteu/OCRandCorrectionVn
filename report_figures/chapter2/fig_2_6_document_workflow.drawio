<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.6 – Quy trình xử lý tài liệu tổng quát của hệ thống" id="fig_2_6_document_workflow"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.6 – Quy trình xử lý tài liệu tổng quát của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1220" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Flow chart of the implemented request path (app.py · ocr_service.py · models.py)" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1220" height="20" as="geometry"/></mxCell><mxCell id="s1" value="Start — user selects a file in the SPA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="118" width="380" height="46" as="geometry"/></mxCell><mxCell id="d1" value="Authenticated?&lt;br&gt;@login_required" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="186" width="380" height="62" as="geometry"/></mxCell><mxCell id="d2" value="Body ≤ MAX_CONTENT_LENGTH?&lt;br&gt;(cfg.MAX_UPLOAD_MB = 50)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="380" height="62" as="geometry"/></mxCell><mxCell id="d3" value="Extension in allowlist?&lt;br&gt;.jpg .jpeg .png .webp .pdf .txt .docx" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="358" width="380" height="62" as="geometry"/></mxCell><mxCell id="s2" value="Sanitize display name · generate UUID ·&lt;br&gt;save uploads/{uuid}{suffix}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="444" width="380" height="50" as="geometry"/></mxCell><mxCell id="s3" value="Count pages (pypdfium2) · INSERT Document&lt;br&gt;(status = &quot;uploaded&quot;) · log_activity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="518" width="380" height="50" as="geometry"/></mxCell><mxCell id="d4" value="File type?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="592" width="380" height="62" as="geometry"/></mxCell><mxCell id="s4" value="Render page → PIL image&lt;br&gt;(PDF: pdf_page_to_pil, scale = 2.0)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="678" width="380" height="50" as="geometry"/></mxCell><mxCell id="s5" value="Resolve OCR engine (request parameter → alias → default)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="752" width="380" height="46" as="geometry"/></mxCell><mxCell id="s6" value="Run the selected engine adapter" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="818" width="380" height="46" as="geometry"/></mxCell><mxCell id="d5" value="OCR succeeded?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="884" width="380" height="62" as="geometry"/></mxCell><mxCell id="s7" value="Post-process: normalize blocks · reading-order&lt;br&gt;reconstruction · overlay image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="970" width="380" height="50" as="geometry"/></mxCell><mxCell id="s8" value="Persist artifacts · status = &quot;ocr_done&quot; · log_activity(&quot;ocr&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="1044" width="380" height="46" as="geometry"/></mxCell><mxCell id="sTxt" value="TXT / DOCX / PDF text&lt;br&gt;/api/read-text → text_service.read_file()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="760" y="678" width="300" height="50" as="geometry"/></mxCell><mxCell id="sTxt2" value="save_artifact(kind = &quot;text&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="760" y="752" width="300" height="46" as="geometry"/></mxCell><mxCell id="e1" value="401 / redirect to /login" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="186" width="330" height="56" as="geometry"/></mxCell><mxCell id="e2" value="413 {&quot;error&quot;: &quot;File too large&quot;}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="272" width="330" height="56" as="geometry"/></mxCell><mxCell id="e3" value="400 {&quot;error&quot;: &quot;Unsupported type&quot;}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="358" width="330" height="56" as="geometry"/></mxCell><mxCell id="e5" value="500 {&quot;error&quot;: &quot;OCR failed (engine)&quot;}&lt;br&gt;traceback written to the log" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="884" width="330" height="56" as="geometry"/></mxCell><mxCell id="own" value="Every later request re-checks ownership:&lt;br&gt;_resolve_owned_file() → 404 unknown,&lt;br&gt;403 not owner (admins exempt)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="44" y="460" width="230" height="76" as="geometry"/></mxCell><mxCell id="res" value="Result delivery&lt;br&gt;• JSON response → SPA&lt;br&gt;• Markdown / Raw / Images / JSON tabs&lt;br&gt;• Download .md .txt .json .docx&lt;br&gt;• Optional Vietnamese correction&lt;br&gt;  (/api/correction/run)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="44" y="960" width="230" height="120" as="geometry"/></mxCell><mxCell id="n1" value="Note: preprocessing is limited to page rasterization and, for the PaddleOCR Modern engine, the pipeline&#x27;s own document orientation classification and UVDoc unwarping. No separate binarization / deskew stage exists in the application code." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="44" y="1096" width="1216" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounde