<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.6 – Quy trình xử lý tài liệu tổng quát của hệ thống" id="fig_2_6_document_workflow"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.6 – Quy trình xử lý tài liệu tổng quát của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1220" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Lưu đồ đường đi thực tế của một yêu cầu (app.py · ocr_service.py · models.py)" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1220" height="20" as="geometry"/></mxCell><mxCell id="s1" value="Bắt đầu — người dùng chọn tệp trên SPA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="118" width="380" height="46" as="geometry"/></mxCell><mxCell id="d1" value="Đã đăng nhập?&lt;br&gt;@login_required" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="186" width="380" height="62" as="geometry"/></mxCell><mxCell id="d2" value="Kích thước ≤ MAX_CONTENT_LENGTH?&lt;br&gt;(cfg.MAX_UPLOAD_MB = 50)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="380" height="62" as="geometry"/></mxCell><mxCell id="d3" value="Phần mở rộng hợp lệ?&lt;br&gt;.jpg .jpeg .png .webp .pdf .txt .docx" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="358" width="380" height="62" as="geometry"/></mxCell><mxCell id="s2" value="Làm sạch tên hiển thị · sinh UUID ·&lt;br&gt;lưu uploads/{uuid}{suffix}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="444" width="380" height="50" as="geometry"/></mxCell><mxCell id="s3" value="Đếm số trang (pypdfium2) · INSERT Document&lt;br&gt;(status = &quot;uploaded&quot;) · log_activity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="518" width="380" height="50" as="geometry"/></mxCell><mxCell id="d4" value="Loại tệp?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="592" width="380" height="62" as="geometry"/></mxCell><mxCell id="s4" value="Kết xuất trang → ảnh PIL&lt;br&gt;(PDF: pdf_page_to_pil, scale = 2.0)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="678" width="380" height="50" as="geometry"/></mxCell><mxCell id="s5" value="Xác định công cụ OCR (tham số → bí danh → mặc định)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="752" width="380" height="46" as="geometry"/></mxCell><mxCell id="s6" value="Chạy bộ thích nghi của công cụ đã chọn" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="818" width="380" height="46" as="geometry"/></mxCell><mxCell id="d5" value="OCR thành công?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="884" width="380" height="62" as="geometry"/></mxCell><mxCell id="s7" value="Hậu xử lý: chuẩn hóa khối · dựng lại thứ tự đọc&lt;br&gt;· vẽ ảnh phủ vùng nhận dạng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="970" width="380" height="50" as="geometry"/></mxCell><mxCell id="s8" value="Lưu kết xuất · status = &quot;ocr_done&quot; · log_activity(&quot;ocr&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="300" y="1044" width="380" height="46" as="geometry"/></mxCell><mxCell id="sTxt" value="Văn bản TXT / DOCX / PDF&lt;br&gt;/api/read-text → text_service.read_file()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="760" y="678" width="300" height="50" as="geometry"/></mxCell><mxCell id="sTxt2" value="save_artifact(kind = &quot;text&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="760" y="752" width="300" height="46" as="geometry"/></mxCell><mxCell id="e1" value="401 / chuyển hướng tới /login" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="186" width="330" height="56" as="geometry"/></mxCell><mxCell id="e2" value="413 {&quot;error&quot;: &quot;File too large&quot;}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="272" width="330" height="56" as="geometry"/></mxCell><mxCell id="e3" value="400 {&quot;error&quot;: &quot;Unsupported type&quot;}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="358" width="330" height="56" as="geometry"/></mxCell><mxCell id="e5" value="500 {&quot;error&quot;: &quot;OCR failed (engine)&quot;}&lt;br&gt;ghi vết lỗi vào nhật ký" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="900" y="884" width="330" height="56" as="geometry"/></mxCell><mxCell id="own" value="Mọi yêu cầu sau đó đều kiểm tra lại&lt;br&gt;quyền sở hữu: _resolve_owned_file()&lt;br&gt;→ 404 không tồn tại,&lt;br&gt;403 không phải chủ sở hữu&lt;br&gt;(quản trị viên là ngoại lệ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="44" y="460" width="230" height="76" as="geometry"/></mxCell><mxCell id="res" value="Trả kết quả&lt;br&gt;• Phản hồi JSON → SPA&lt;br&gt;• Thẻ Markdown / Raw / Images / JSON&lt;br&gt;• Tải về .md .txt .json .docx&lt;br&gt;• Tùy chọn hiệu chỉnh tiếng Việt&lt;br&gt;  (/api/correction/run)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="44" y="960" width="230" height="120" as="geometry"/></mxCell><mxCell id="n1" value="Ghi chú: khâu tiền xử lý chỉ gồm kết xuất ảnh trang và, riêng với công cụ PaddleOCR Modern, phân loại hướng tài liệu cùng nắn phẳng UVDoc do chính pipeline đó thực hiện. Mã ứng dụng không có bước nhị phân hóa hay hiệu chỉnh nghiêng riêng." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="44" y="1096" width="1216" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCe