<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.4 – Kiến trúc triển khai của hệ thống" id="fig_2_4_deployment"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.4 – Kiến trúc triển khai của hệ thống" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1260" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Deployment view — processes, ports and communication paths defined by app.py, config.py, tools/glm_serve.sh and RUN_MACOS.md" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1260" height="20" as="geometry"/></mxCell><mxCell id="client" value="Client device" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F0F6FD;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="300" height="230" as="geometry"/></mxCell><mxCell id="host" value="Application host  —  macOS Apple Silicon · Python 3.10  (RUN_MACOS.md)" style="swimlane;rounded=1;arcSize=4;startSize=38;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFF5EB;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="800" height="530" as="geometry"/></mxCell><mxCell id="stor" value="Local storage on the host" style="swimlane;rounded=1;arcSize=4;startSize=30;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#EDEDED;strokeColor=#5A5A5A;swimlaneFillColor=#F8F8F8;fontColor=#10202E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="516" width="740" height="96" as="geometry"/></mxCell><mxCell id="browser" value="Web browser&lt;br&gt;SPA + server-rendered admin pages&lt;br&gt;(no frontend build step)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="client"><mxGeometry x="26" y="52" width="248" height="76" as="geometry"/></mxCell><mxCell id="brnote" value="http://&lt;host&gt;:5001&lt;br&gt;Session cookie&lt;br&gt;(HttpOnly · SameSite=Lax)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="client"><mxGeometry x="26" y="144" width="248" height="64" as="geometry"/></mxCell><mxCell id="flask" value="Process 1 · Flask application server&lt;br&gt;glm-ocr-ui/.venv/bin/python app.py&lt;br&gt;app.run(host=cfg.HOST 0.0.0.0, port=cfg.PORT 5001, threaded=True, debug=False)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D4E1F5;strokeColor=#3F61A8;fontColor=#15202B;fontStyle=1;" vertex="1" parent="host"><mxGeometry x="30" y="58" width="740" height="82" as="geometry"/></mxCell><mxCell id="inproc" value="In-process OCR runtimes&lt;br&gt;(same interpreter as Flask)&lt;br&gt;PaddleOCR · PP-StructureV3 · VietOCR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="host"><mxGeometry x="30" y="168" width="356" height="80" as="geometry"/></mxCell><mxCell id="sdkp" value="Process 3 (transient) · GLM-OCR SDK&lt;br&gt;.venv-sdk · python -m glmocr.cli parse&lt;br&gt;spawned per OCR call · timeout GLM_TIMEOUT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="host"><mxGeometry x="414" y="168" width="356" height="80" as="geometry"/></mxCell><mxCell id="pandoc" value="pandoc executable (optional)&lt;br&gt;resolved with shutil.which() at import;&lt;br&gt;/api/ocr/export-docx returns 501 if absent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#15202B;" vertex="1" parent="host"><mxGeometry x="30" y="292" width="356" height="80" as="geometry"/></mxCell><mxCell id="mlxp" value="Process 2 · GLM-OCR MLX model server&lt;br&gt;.venv-mlx · python -m mlx_vlm.server&lt;br&gt;listens on :8080 · model held resident" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#15202B;" vertex="1" parent="host"><mxGeometry x="414" y="292" width="356" height="80" as="geometry"/></mxCell><mxCell id="db" value="SQLite  paddleocr.db&lt;br&gt;(cfg.DB_PATH)" style="shape=cylinder3;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="stor"><mxGeometry x="18" y="36" width="226" height="50" as="geometry"/></mxCell><mxCell id="up" value="uploads/ {uuid4}{suffix}&lt;br&gt;(cfg.UPLOAD_DIR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="stor"><mxGeometry x="262" y="36" width="216" height="50" as="geometry"/></mxCell><mxCell id="mdl" value="models/ + HF cache&lt;br&gt;(cfg.MODEL_DIR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#EDEDED;strokeColor=#5A5A5A;fontColor=#15202B;" vertex="1" parent="stor"><mxGeometry x="496" y="36" width="226" height="50" as="geometry"/></mxCell><mxCell id="n1" value="Deployment facts taken from the repository: there is no container, reverse proxy, production WSGI server, message queue or managed cloud service for the web application — app.py starts Flask&#x27;s own threaded development server. The Dockerfiles and docker start scripts under glm-ocr-server/apps/ belong to the upstream GLM-OCR demo (FastAPI backend + React frontend) and are not used by SmartDocs. Processes 2 and 3 are optional: without them only the PaddleOCR / VietOCR engines are available." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="50" y="660" width="1240" height="92" as="geometry"/></mxCell><mxCell id="e0" value="HTTP  (localhost or LAN)&lt;br&gt;JSON + multipart upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#3F61A8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="flask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="in-process call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="inproc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="254"/><mxPoint x="638" y="254"/></Array></mxGeometry></mxCell><mxCell id="e2" value="subprocess.run()&lt;br&gt;sanitized environment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="sdkp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="254"/><mxPoint x="1022" y="254"/></Array></mxGeometry></mxCell><mxCell id="e3" value="HTTP localhost:8080  ·  /chat/completions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#D79B00;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdkp" target="mlxp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="subprocess.run(pandoc)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#999999;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="pandoc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="199"/><mxPoint x="452" y="432"/></Array></mxGeometry></mxCell><mxCell id="e5" value="SQLAlchemy  ·  file I/O" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flask" target="stor"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1216" y="199"/><mxPoint x="1216" y="564"/></Array></mxGeometry></mxCell><mxCell id="e6" value="model files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="inproc" target="mdl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="638" y="494"/><mxPoint x="1069" y="494"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>