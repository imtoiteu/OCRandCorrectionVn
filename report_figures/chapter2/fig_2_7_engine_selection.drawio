<mxfile host="app.diagrams.net" type="device"><diagram name="Hình 2.7 – Cơ chế lựa chọn công cụ OCR theo đặc điểm tài liệu" id="fig_2_7_engine_selection"><mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Hình 2.7 – Cơ chế lựa chọn công cụ OCR theo đặc điểm tài liệu" style="text;html=1;fontSize=20;fontStyle=1;verticalAlign=middle;align=left;fontColor=#10202E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1260" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Cơ chế đúng như đã hiện thực hóa — app.py::_resolve_selected_engine(), router.py::normalize_engine_name(), glm_vietocr_adapter.py" style="text;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1260" height="20" as="geometry"/></mxCell><mxCell id="warn" value="LƯU Ý QUAN TRỌNG — hệ thống KHÔNG hiện thực hóa cơ chế tự động chọn công cụ theo nội dung tài liệu. Không có đoạn mã nào xét độ phức tạp bố cục, ngôn ngữ hay chất lượng ảnh để chọn công cụ. Công cụ do người dùng chọn (hộp thả xuống) hoặc do cấu hình quyết định; chỉ tồn tại hai quyết định theo quy tắc, cả hai đều được thể hiện dưới đây." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1260" height="74" as="geometry"/></mxCell><mxCell id="start" value="Yêu cầu OCR:  {file_id, page, engine?}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="196" width="420" height="46" as="geometry"/></mxCell><mxCell id="d1" value="Yêu cầu có kèm giá trị&lt;br&gt;tham số &quot;engine&quot; không?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="440" y="268" width="460" height="68" as="geometry"/></mxCell><mxCell id="cfg" value="Không → dùng cfg.OCR_ENGINE&lt;br&gt;(biến OCR_ENGINE, mặc định &quot;paddle&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F7FD;strokeColor=#4B6E9C;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="340" height="62" as="geometry"/></mxCell><mxCell id="ui" value="Có → giá trị người dùng chọn trên SPA&lt;br&gt;&quot;Recommended&quot;  → glmocr&lt;br&gt;&quot;GLM Layout + VietOCR Text&quot;  → glm_vietocr&lt;br&gt;&quot;Vietnamese&quot;  → vietocr&lt;br&gt;&quot;Standard&quot;  → paddleocr" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="960" y="254" width="340" height="110" as="geometry"/></mxCell><mxCell id="norm" value="normalize_engine_name(): bảng bí danh&lt;br&gt;paddle|auto→paddleocr · modern|ppstructure→paddleocr_modern&lt;br&gt;glm|glm_ocr→glmocr · glm_layout_vietocr→glm_vietocr" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="440" y="368" width="460" height="66" as="geometry"/></mxCell><mxCell id="bad" value="Bí danh không hợp lệ → ValueError → HTTP 400" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="960" y="380" width="340" height="46" as="geometry"/></mxCell><mxCell id="d2" value="QUY TẮC 1 (theo loại tệp)&lt;br&gt;engine đã chọn == &quot;vietocr&quot;  VÀ  phần mở rộng == &quot;.pdf&quot; ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10.5;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="420" y="466" width="500" height="76" as="geometry"/></mxCell><mxCell id="fb" value="engine thực thi = &quot;paddleocr&quot;&lt;br&gt;inference_status = &quot;fallback_to_paddle_for_pdf&quot;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="960" y="476" width="340" height="58" as="geometry"/></mxCell><mxCell id="disp" value="engine thực thi → router.get_engine(name).run(image)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="578" width="460" height="46" as="geometry"/></mxCell><mxCell id="en1" value="PaddleOCREngine&lt;br&gt;PP-OCRv5&lt;br&gt;(dòng văn bản + khung bao)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="236" height="84" as="geometry"/></mxCell><mxCell id="en2" value="PaddleOCRModernEngine&lt;br&gt;PP-StructureV3 + PP-OCRv6&lt;br&gt;(markdown/html/bảng)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="296" y="660" width="236" height="84" as="geometry"/></mxCell><mxCell id="en3" value="VietOCREngine&lt;br&gt;PP-OCRv5 phát hiện dòng +&lt;br&gt;VietOCR nhận dạng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="552" y="660" width="236" height="84" as="geometry"/></mxCell><mxCell id="en4" value="GLMOCREngine&lt;br&gt;PP-DocLayoutV3 + mô hình&lt;br&gt;GLM-OCR (tiến trình con)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="808" y="660" width="236" height="84" as="geometry"/></mxCell><mxCell id="en5" value="GLMVietOCREngine&lt;br&gt;Bố cục GLM + văn bản VietOCR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=9.5;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="1064" y="660" width="236" height="84" as="geometry"/></mxCell><mxCell id="r2" value="QUY TẮC 2 (theo từng khối, chỉ bên trong GLMVietOCREngine)&lt;br&gt;• nhãn khối ∈ {table, figure, image, equation, formula, code} → giữ nguyên văn bản của GLM&lt;br&gt;• ngược lại, gán các dòng VietOCR có tâm nằm trong khung bao của khối GLM&lt;br&gt;• kiểm tra hợp lý: nếu độ dài văn bản GLM &gt; 40 ký tự và văn bản VietOCR &lt; 25 % độ dài đó&lt;br&gt;  thì loại bỏ và quay về văn bản GLM (recognition_source = &quot;glm&quot; / &quot;fallback&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="620" height="128" as="geometry"/></mxCell><mxCell id="n2" value="Một số dữ kiện khác từ mã nguồn&lt;br&gt;• paddleocr_modern có đăng ký trong router.py và gọi được qua API, nhưng không xuất hiện&lt;br&gt;  trong hộp thả xuống của SPA (static/index.html).&lt;br&gt;• Công cụ đã dùng được ghi lại theo từng yêu cầu: res[&quot;selected_engine&quot;], res[&quot;ocr_engine&quot;] và&lt;br&gt;  chuỗi mô tả trong ActivityLog, nhờ đó có thể so sánh nhiều lần xử lý trên cùng một tài liệu.&lt;br&gt;• Lựa chọn thủ công của người dùng được giữ trong suốt phiên (OCRView._sessionEngine)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#15202B;" vertex="1" parent="1"><mxGeometry x="700" y="782" width="600" height="128" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="en1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="en2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="en3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="en4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#0E8088;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="en5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="en5" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="cfg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg" target="norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui" target="norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#4B6E9C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="không hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeColor=#B85450;label